[
  {"op": "log", "value": "@no_modules: a new project downloads selected modules but creates no files"},
  {"op": "assert_modules", "installed": []},
  {"op": "command", "value": "file.new_project"},
  {"op": "assert_popup", "value": "new_project"},
  {"op": "wait", "what": "modules_index", "timeout": 30},
  {"op": "wait", "what": "modules_idle", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "new_project_set", "parent": "${PROJ}_new", "name": "Hello App", "modules": ["python", "markdown"], "template": "python/Script"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_dialog.png"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "no_popup", "timeout": 60},
  {"op": "wait", "what": "modules_idle", "timeout": 60},
  {"op": "wait", "what": "index"},
  {"op": "frames", "value": 6},
  {"op": "assert_modules", "installed": ["markdown", "python"], "enabled": ["markdown", "python"]},
  {"op": "assert_empty_directory", "path": "${PROJ}_new/hello-app"},
  {"op": "assert_project_config", "path": "${PROJ}_new/hello-app", "value": "python"},
  {"op": "assert_project_config", "path": "${PROJ}_new/hello-app", "value": "markdown"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_created.png"},

  {"op": "log", "value": "Lisp projects also start empty, even for legacy template requests"},
  {"op": "module_install", "value": "lisp"},
  {"op": "wait", "what": "modules_idle", "timeout": 30},
  {"op": "command", "value": "file.new_project"},
  {"op": "new_project_set", "parent": "${PROJ}_new", "name": "Lisp Demo", "modules": ["lisp"], "template": "@auto"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "ask_open", "timeout": 30},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "no_popup", "timeout": 60},
  {"op": "wait", "what": "index"},
  {"op": "assert_empty_directory", "path": "${PROJ}_new/lisp-demo"},
  {"op": "assert_project_config", "path": "${PROJ}_new/lisp-demo", "value": "lisp"},
  {"op": "quit"}
]
