[
  {"op": "log", "value": "@no_modules: a new project chooses its modules, which are downloaded first, and starts from their template"},
  {"op": "assert_modules", "installed": []},
  {"op": "command", "value": "file.new_project"},
  {"op": "assert_popup", "value": "new_project"},
  {"op": "wait", "what": "modules_index", "timeout": 30},
  {"op": "wait", "what": "modules_idle", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "new_project_set", "parent": "${PROJ}_new", "name": "Hello App", "modules": ["python", "markdown"], "template": "python/Script"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_dialog.png"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "no_popup", "timeout": 60},
  {"op": "wait", "what": "modules_idle", "timeout": 60},
  {"op": "wait", "what": "index"},
  {"op": "frames", "value": 6},
  {"op": "assert_modules", "installed": ["markdown", "python"], "enabled": ["markdown", "python"]},
  {"op": "assert_file_contains", "path": "${PROJ}_new/hello-app/main.py", "value": "Hello, Light"},
  {"op": "assert_file_contains", "path": "${PROJ}_new/hello-app/.light/project.json", "value": "python"},
  {"op": "assert_file_contains", "path": "${PROJ}_new/hello-app/.light/project.json", "value": "markdown"},
  {"op": "assert_language", "value": "python"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_created.png"},

  {"op": "log", "value": "Lisp is a template of the Lisp module like any other"},
  {"op": "module_install", "value": "lisp"},
  {"op": "wait", "what": "modules_idle", "timeout": 30},
  {"op": "command", "value": "file.new_project"},
  {"op": "new_project_set", "parent": "${PROJ}_new", "name": "Lisp Demo", "modules": ["lisp"], "template": "@auto"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "no_popup", "timeout": 60},
  {"op": "wait", "what": "index"},
  {"op": "assert_file_contains", "path": "${PROJ}_new/lisp-demo/lisp-demo.asd", "value": "(asdf:defsystem \"lisp-demo\""},
  {"op": "assert_file_contains", "path": "${PROJ}_new/lisp-demo/src/main.lisp", "value": "(in-package :lisp-demo)"},
  {"op": "assert_language", "value": "lisp"},
  {"op": "quit"}
]
