[
  {"op":"log","value":"@merge_conflict merging a branch stops for conflicts; they are resolved per file or per conflict, then the merge is committed"},
  {"op":"open_project","path":"${PROJ}"},
  {"op":"wait","what":"index"},
  {"op":"wait","what":"git_ready","timeout":30},

  {"op":"log","value":"merge, then give it up: the files are as before"},
  {"op":"command","value":"git.merge"},
  {"op":"frames","value":2},
  {"op":"assert_popup","value":"palette"},
  {"op":"text","value":"feature"},
  {"op":"key","value":"Enter"},
  {"op":"frames","value":3},
  {"op":"assert_popup","value":"conflicts"},
  {"op":"assert_merge","value":"merge","conflicted":2},
  {"op":"assert_file_contains","path":"${PROJ}/notes/whole.txt","value":"<<<<<<< HEAD"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_dialog.png"},
  {"op":"key","value":"Escape"},
  {"op":"frames","value":2},
  {"op":"command","value":"git.merge_abort"},
  {"op":"frames","value":3},
  {"op":"assert_merge","value":"none","conflicted":0},
  {"op":"assert_file_contains","path":"${PROJ}/notes/whole.txt","value":"main line"},

  {"op":"log","value":"merge again: one file takes their side as a whole"},
  {"op":"command","value":"git.merge"},
  {"op":"frames","value":2},
  {"op":"text","value":"feature"},
  {"op":"key","value":"Enter"},
  {"op":"frames","value":3},
  {"op":"conflict_click","value":"theirs:notes/whole.txt"},
  {"op":"frames","value":3},
  {"op":"assert_merge","value":"merge","conflicted":1},
  {"op":"assert_file_contains","path":"${PROJ}/notes/whole.txt","value":"feature line"},

  {"op":"log","value":"the other is merged by hand in the editor: each conflict tinted, resolved from the bar above it"},
  {"op":"conflict_click","value":"merge:notes/parts.txt"},
  {"op":"frames","value":3},
  {"op":"assert_active_file","value":"parts.txt"},
  {"op":"assert_text_contains","value":">>>>>>> feature"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_editor.png"},
  {"op":"conflict_click","value":"ours"},
  {"op":"frames","value":3},
  {"op":"conflict_click","value":"both"},
  {"op":"frames","value":3},
  {"op":"assert_text","value":"alpha\nfirst = main\nm1\nm2\nm3\nm4\nm5\nm6\nsecond = main\nsecond = feature\nomega\n"},
  {"op":"command","value":"edit.undo"},
  {"op":"frames","value":2},
  {"op":"assert_text_contains","value":"<<<<<<< HEAD\nsecond = main"},
  {"op":"conflict_click","value":"theirs"},
  {"op":"frames","value":3},
  {"op":"assert_text","value":"alpha\nfirst = main\nm1\nm2\nm3\nm4\nm5\nm6\nsecond = feature\nomega\n"},
  {"op":"conflict_click","value":"Mark as Resolved"},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"assert_merge","value":"merge","conflicted":0},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_resolved.png"},

  {"op":"log","value":"the merge is committed"},
  {"op":"command","value":"git.merge_continue"},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"assert_merge","value":"none","conflicted":0},
  {"op":"assert_git_log","value":"Merge branch 'feature'"},
  {"op":"assert_file_contains","path":"${PROJ}/notes/parts.txt","value":"second = feature"},
  {"op":"quit"}
]
