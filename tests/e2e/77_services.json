[
  {"op":"log","value":"@docker_module @modules docker the Services window: containers by Compose project, their logs followed, start, stop and remove"},
  {"op":"open_project","path":"${PROJ}"},
  {"op":"wait","what":"index"},
  {"op":"command","value":"view.services"},
  {"op":"frames","value":2},
  {"op":"assert_bottom","value":"services"},
  {"op":"wait","what":"services_listed","timeout":30},
  {"op":"frames","value":3},
  {"op":"assert_container","name":"demo-web-1","value":"running"},
  {"op":"assert_container","name":"demo-db-1","value":"exited"},
  {"op":"assert_container","name":"scratch","value":"exited"},

  {"op":"log","value":"a running container: its logs go on as it writes them"},
  {"op":"services_click","value":"container:demo-web-1"},
  {"op":"frames","value":2},
  {"op":"wait","what":"services_logs","value":"demo-web-1 log line 3","timeout":30},
  {"op":"wait","what":"services_logs","value":"demo-web-1 tick 2","timeout":30},
  {"op":"frames","value":3},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_logs.png"},

  {"op":"log","value":"stop it, start the database"},
  {"op":"services_click","value":"action:stop"},
  {"op":"frames","value":2},
  {"op":"wait","what":"container_state","name":"demo-web-1","value":"exited","timeout":30},
  {"op":"wait","what":"services_listed","timeout":30},
  {"op":"frames","value":3},
  {"op":"services_click","value":"container:demo-db-1"},
  {"op":"frames","value":2},
  {"op":"services_click","value":"action:start"},
  {"op":"frames","value":2},
  {"op":"wait","what":"container_state","name":"demo-db-1","value":"running","timeout":30},
  {"op":"frames","value":3},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_started.png"},

  {"op":"log","value":"removing asks first"},
  {"op":"services_click","value":"container:scratch"},
  {"op":"frames","value":2},
  {"op":"services_click","value":"action:rm"},
  {"op":"frames","value":2},
  {"op":"assert_popup","value":"confirm"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_remove.png"},
  {"op":"confirm_accept"},
  {"op":"frames","value":2},
  {"op":"wait","what":"services_listed","timeout":30},
  {"op":"frames","value":8},
  {"op":"wait","what":"services_listed","timeout":30},
  {"op":"assert_container","name":"scratch","value":"gone"},
  {"op":"quit"}
]
