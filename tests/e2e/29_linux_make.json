[
  {"op": "log", "value": "@os_project @linux_distro: a C/make project is offered to Linux, built there, its gcc errors land in Problems"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_env", "value": "windows", "banner": true, "run_config": "make all"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_banner.png"},

  {"op": "log", "value": "C and assembly are not read as Lisp: no false errors"},
  {"op": "open", "path": "${PROJ}/portable/eval.c"},
  {"op": "open", "path": "${PROJ}/x86/boot.asm"},
  {"op": "open", "path": "${PROJ}/makefile"},
  {"op": "frames", "value": 3},
  {"op": "assert_max_problems", "value": 0},

  {"op": "log", "value": "use Linux for this project: the choice is remembered in the IDE profile"},
  {"op": "project_env", "value": "Ubuntu-24.04"},
  {"op": "frames", "value": 3},
  {"op": "assert_env", "value": "linux:Ubuntu-24.04", "banner": false, "run_config": "make all"},
  {"op": "assert_project_config", "path": "${PROJ}", "value": "Ubuntu-24.04"},

  {"op": "log", "value": "the distribution has no developer tools yet: the project offers to install them"},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "assert_env", "value": "linux:Ubuntu-24.04", "banner": false, "tools_banner": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_tools_banner.png"},

  {"op": "log", "value": "make without make installed: Run and the terminal say why instead of a bare exit code"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 60},
  {"op": "assert_run_contains", "value": "make is not installed in Linux (Ubuntu-24.04)"},
  {"op": "terminal_mode", "value": "commands"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "frames", "value": 4},
  {"op": "text", "value": "make"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_contains", "value": "is not installed in Linux", "timeout": 30},
  {"op": "wait", "what": "term_idle", "timeout": 30},
  {"op": "assert_term_contains", "value": "Permission denied"},
  {"op": "assert_term_contains", "value": "[exit code 127]"},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_make_missing.png"},

  {"op": "log", "value": "Install developer tools in the banner: the progress is shown, then the banner is gone"},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "assert_env", "tools_banner": true},
  {"op": "banner_install_tools"},
  {"op": "wait", "what": "wsl_progress", "value": 0.3, "timeout": 30},
  {"op": "assert_wsl_progress", "stage": "Install", "min": 0.3, "max": 0.97},
  {"op": "frames", "value": 2},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_tools_progress.png"},
  {"op": "wait", "what": "wsl_idle", "timeout": 60},
  {"op": "frames", "value": 3},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "assert_wsl", "selected": "Ubuntu-24.04", "tools": "ready", "outcome_contains": "developer tools are installed"},
  {"op": "key", "value": "Escape"},
  {"op": "frames", "value": 3},
  {"op": "assert_env", "tools_banner": false},

  {"op": "log", "value": "make all runs in the distribution; the compiler error points into portable/eval.c"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 60},
  {"op": "assert_run_contains", "value": "Entering directory"},
  {"op": "assert_make_problem", "file": "portable/eval.c", "line": 3},
  {"op": "open", "path": "${PROJ}/portable/eval.c"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_error.png"},

  {"op": "log", "value": "git in Linux takes the name, e-mail and logins of Windows"},
  {"op": "command", "value": "app.settings"},
  {"op": "settings_page", "value": 3},
  {"op": "frames", "value": 4},
  {"op": "wsl_action", "value": "git_setup", "arg": "Ubuntu-24.04"},
  {"op": "wait", "what": "wsl_idle", "timeout": 60},
  {"op": "assert_wsl", "outcome_contains": "uses your name"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_setup.png"},
  {"op": "wheel", "x": 740, "y": 500, "dy": -1500},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_developer_tools.png"},
  {"op": "key", "value": "Escape"},

  {"op": "log", "value": "the project is reopened in Linux without asking again"},
  {"op": "close_project"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "frames", "value": 3},
  {"op": "assert_env", "value": "linux:Ubuntu-24.04", "banner": false},
  {"op": "project_env", "value": "windows"},
  {"op": "assert_env", "value": "windows", "banner": false},
  {"op": "quit"}
]
