[
  {"op": "log", "value": "every run has a tab of its own; the tabs keep the order they were opened in"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "open", "path": "${PROJ}/src/main.lisp"},
  {"op": "scenario", "value": "first", "commands": ["echo first-output"]},
  {"op": "scenario", "value": "second", "commands": ["echo second-output"]},
  {"op": "scenario", "value": "broken", "commands": ["exit 4"]},
  {"op": "select_run", "value": "scenario:first"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "select_run", "value": "scenario:second"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "select_run", "value": "scenario:broken"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "frames", "value": 3},
  {"op": "assert_run_tabs", "value": ["first", "second", "broken"], "active": "broken"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_tabs.png"},

  {"op": "log", "value": "a click shows a tab without moving the others"},
  {"op": "run_tab_click", "value": "first"},
  {"op": "frames", "value": 3},
  {"op": "assert_run_tabs", "value": ["first", "second", "broken"], "active": "first"},
  {"op": "assert_run_contains", "value": "first-output"},
  {"op": "assert_run_lacks", "value": "second-output"},

  {"op": "log", "value": "running a configuration again uses its own tab"},
  {"op": "select_run", "value": "scenario:second"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "frames", "value": 3},
  {"op": "assert_run_tabs", "value": ["first", "second", "broken"], "active": "second"},

  {"op": "log", "value": "closing the shown tab shows the next one"},
  {"op": "run_tab_click", "value": "second", "close": true},
  {"op": "frames", "value": 3},
  {"op": "assert_run_tabs", "value": ["first", "broken"], "active": "broken"},
  {"op": "run_tab_click", "value": "first", "close": true},
  {"op": "frames", "value": 3},
  {"op": "assert_run_tabs", "value": ["broken"], "active": "broken"},
  {"op": "run_tab_click", "value": "broken", "close": true},
  {"op": "frames", "value": 3},
  {"op": "assert_run_tabs", "value": []},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_empty.png"},
  {"op": "quit"}
]
