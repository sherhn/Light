[
  {"op": "log", "value": "@linux_distro: a project that runs in Linux has the distribution's own shell in the Terminal window"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "project_env", "value": "Ubuntu-24.04"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "assert_bottom", "value": "terminal"},
  {"op": "wait", "what": "shell_contains", "value": "user@Ubuntu-24.04:/mnt/", "timeout": 30},
  {"op": "frames", "value": 3},
  {"op": "assert_shell_focused", "value": true},

  {"op": "log", "value": "what a shell keeps between commands stays: an exported variable"},
  {"op": "text", "value": "export GREETING=kept"},
  {"op": "key", "value": "Enter"},
  {"op": "text", "value": "echo $GREETING-between-commands"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "shell_contains", "value": "kept-between-commands", "timeout": 30},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_shell.png"},

  {"op": "log", "value": "the keys are the shell's: Escape and the IDE's shortcuts do not take the keyboard away"},
  {"op": "key", "value": "Ctrl+Shift+A"},
  {"op": "key", "value": "Escape"},
  {"op": "frames", "value": 3},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_shell_focused", "value": true},

  {"op": "log", "value": "Commands shows the line terminal again; Shell comes back to the same shell"},
  {"op": "terminal_mode", "value": "commands"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "echo from-the-line-terminal"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_contains", "value": "from-the-line-terminal", "timeout": 30},
  {"op": "terminal_mode", "value": "shell"},
  {"op": "frames", "value": 3},
  {"op": "assert_shell_contains", "value": "kept-between-commands"},

  {"op": "log", "value": "the shell ends with exit; Enter starts a new one"},
  {"op": "shell_write", "value": "exit 3\r"},
  {"op": "wait", "what": "shell_ended", "timeout": 30},
  {"op": "shell_focus"},
  {"op": "frames", "value": 2},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 3},
  {"op": "wait", "what": "shell_contains", "value": "user@Ubuntu-24.04:", "timeout": 30},

  {"op": "log", "value": "back on Windows the shell goes and the line terminal is there"},
  {"op": "project_env", "value": "windows"},
  {"op": "wait", "what": "no_shell", "timeout": 10},
  {"op": "text", "value": "echo on-windows-again"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_contains", "value": "on-windows-again", "timeout": 30},
  {"op": "quit"}
]
