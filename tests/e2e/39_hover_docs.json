[
  {"op": "log", "value": "@hover @modules python,c-cpp,assembler: the pointer on a name shows its arguments and documentation"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "project_env", "value": "windows"},
  {"op": "open", "path": "${PROJ}/src/docs.lisp"},
  {"op": "frames", "value": 4},

  {"op": "log", "value": "a function of the project: its lambda list and its docstring"},
  {"op": "hover_on", "value": "greet \"world\""},
  {"op": "wait", "what": "hover", "timeout": 5},
  {"op": "assert_hover", "title": "greet", "kind": "function", "contains": "(greet name &optional (greeting \"hello\"))"},
  {"op": "assert_hover", "contains": "Say GREETING to NAME"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_lisp.png"},
  {"op": "hover_off"},
  {"op": "assert_hover", "value": "none"},

  {"op": "log", "value": "the real pointer does the same: on the call in line 12, then away from any name"},
  {"op": "move", "x": 470, "y": 450},
  {"op": "wait", "what": "hover", "timeout": 5},
  {"op": "assert_hover", "title": "greet", "contains": "Say GREETING to NAME"},
  {"op": "move", "x": 1000, "y": 300},
  {"op": "frames", "value": 6},
  {"op": "assert_hover", "value": "none"},

  {"op": "log", "value": "a macro and a variable"},
  {"op": "hover_on", "value": "with-twice (form)"},
  {"op": "wait", "what": "hover", "timeout": 5},
  {"op": "assert_hover", "title": "with-twice", "kind": "macro", "contains": "Evaluate FORM two times."},
  {"op": "hover_off"},
  {"op": "hover_on", "value": "*greeting* \"hi\""},
  {"op": "wait", "what": "hover", "timeout": 5},
  {"op": "assert_hover", "kind": "variable", "contains": "The default greeting."},
  {"op": "hover_off"},

  {"op": "log", "value": "a standard function without the REPL: it says how to get more"},
  {"op": "hover_on", "value": "car '(1 2)"},
  {"op": "wait", "what": "hover", "timeout": 5},
  {"op": "assert_hover", "title": "car", "contains": "Start the REPL"},
  {"op": "hover_off"},

  {"op": "log", "value": "with the REPL running the answer comes from the image"},
  {"op": "command", "value": "view.repl"},
  {"op": "wait", "what": "repl_ready", "timeout": 90},
  {"op": "hover_on", "value": "car '(1 2)"},
  {"op": "wait", "what": "hover", "timeout": 10},
  {"op": "assert_hover", "title": "car", "kind": "function", "contains": "(car list)"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_image.png"},
  {"op": "hover_off"},
  {"op": "command", "value": "view.repl"},

  {"op": "log", "value": "Python: the def line and the docstring"},
  {"op": "open", "path": "${PROJ}/tools/util.py"},
  {"op": "frames", "value": 4},
  {"op": "hover_on", "value": "area(3"},
  {"op": "wait", "what": "hover", "timeout": 5},
  {"op": "assert_hover", "title": "area", "kind": "function", "contains": "def area(width, height=1):"},
  {"op": "assert_hover", "contains": "Return the area of a rectangle."},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_python.png"},
  {"op": "hover_off"},

  {"op": "log", "value": "a call from another file finds the definition in the project"},
  {"op": "open", "path": "${PROJ}/tools/app.py"},
  {"op": "frames", "value": 4},
  {"op": "hover_on", "value": "area(1"},
  {"op": "wait", "what": "hover", "timeout": 20},
  {"op": "assert_hover", "title": "area", "contains": "Return the area of a rectangle."},
  {"op": "hover_off"},

  {"op": "log", "value": "C: the comment above"},
  {"op": "open", "path": "${PROJ}/native/calc.c"},
  {"op": "frames", "value": 4},
  {"op": "hover_on", "value": "add(1"},
  {"op": "wait", "what": "hover", "timeout": 20},
  {"op": "assert_hover", "title": "add", "contains": "int add(int a, int b)"},
  {"op": "assert_hover", "contains": "Adds two ints."},
  {"op": "hover_off"},

  {"op": "log", "value": "a call with a count no definition takes still finds the only function there is"},
  {"op": "hover_on", "value": "add(1)"},
  {"op": "wait", "what": "hover", "timeout": 20},
  {"op": "assert_hover", "title": "add", "contains": "int add(int a, int b)"},
  {"op": "hover_off"},
  {"op": "caret", "line": 5, "col": 25},
  {"op": "command", "value": "nav.declaration"},
  {"op": "assert_caret", "line": 2, "col": 5},

  {"op": "log", "value": "Go to Declaration in the language of a module: in the same file and in another one"},
  {"op": "caret", "line": 4, "col": 25},
  {"op": "command", "value": "nav.declaration"},
  {"op": "assert_caret", "line": 2, "col": 5},
  {"op": "open", "path": "${PROJ}/tools/app.py"},
  {"op": "caret", "line": 3, "col": 8},
  {"op": "command", "value": "nav.declaration"},
  {"op": "wait", "what": "index", "timeout": 20},
  {"op": "assert_active_file", "value": "util.py"},
  {"op": "assert_caret", "line": 1, "col": 5},

  {"op": "log", "value": "Find Usages in the language of a module"},
  {"op": "command", "value": "find.usages"},
  {"op": "frames", "value": 10},
  {"op": "assert_find_results", "min": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_usages.png"},

  {"op": "log", "value": "a function may be defined in another language: an assembly label for C, C for Lisp"},
  {"op": "open", "path": "${PROJ}/native/calc.c"},
  {"op": "frames", "value": 4},
  {"op": "hover_on", "value": "disable_interrupts();"},
  {"op": "wait", "what": "hover", "timeout": 20},
  {"op": "assert_hover", "title": "disable_interrupts", "contains": "Clears the interrupt flag."},
  {"op": "hover_off"},
  {"op": "caret", "line": 6, "col": 20},
  {"op": "command", "value": "nav.declaration"},
  {"op": "assert_active_file", "value": "boot.asm"},
  {"op": "assert_caret", "line": 5, "col": 1},
  {"op": "open", "path": "${PROJ}/src/ffi.lisp"},
  {"op": "caret", "line": 2, "col": 5},
  {"op": "command", "value": "nav.declaration"},
  {"op": "assert_active_file", "value": "calc.c"},
  {"op": "assert_caret", "line": 2, "col": 5},
  {"op": "open", "path": "${PROJ}/src/ffi.lisp"},
  {"op": "caret", "line": 3, "col": 5},
  {"op": "command", "value": "nav.declaration"},
  {"op": "assert_active_file", "value": "boot.asm"},
  {"op": "open", "path": "${PROJ}/native/boot.asm"},
  {"op": "caret", "line": 5, "col": 3},
  {"op": "command", "value": "find.usages"},
  {"op": "frames", "value": 10},
  {"op": "assert_find_results", "min": 3},

  {"op": "open", "path": "${PROJ}/native/calc.c"},
  {"op": "frames", "value": 4},
  {"op": "log", "value": "nothing in comments and nothing for names that are not defined"},
  {"op": "open", "path": "${PROJ}/native/calc.c"},
  {"op": "frames", "value": 4},
  {"op": "hover_on", "value": "Adds two"},
  {"op": "frames", "value": 30},
  {"op": "assert_hover", "value": "none"},
  {"op": "hover_on", "value": "return a"},
  {"op": "frames", "value": 40},
  {"op": "assert_hover", "value": "none"},
  {"op": "quit"}
]
