[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "log", "value": "the terminal opens with an empty command line"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "frames", "value": 4},
  {"op": "text", "value": "echo first-command"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_idle", "timeout": 20},
  {"op": "text", "value": "echo second-command"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_idle", "timeout": 20},
  {"op": "assert_term_history", "value": "echo second-command"},
  {"op": "log", "value": "the history is a file in the settings folder, shared by every project"},
  {"op": "assert_file_contains", "path": "${CFG}/terminal_history.jsonl", "value": "echo second-command"},

  {"op": "log", "value": "Up and Down walk through the commands typed so far"},
  {"op": "key", "value": "Up"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "echo second-command"},
  {"op": "key", "value": "Up"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "echo first-command"},
  {"op": "key", "value": "Down"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "echo second-command"},
  {"op": "key", "value": "Down"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": ""},

  {"op": "log", "value": "what was being typed comes back after Down"},
  {"op": "text", "value": "ec"},
  {"op": "frames", "value": 2},
  {"op": "key", "value": "Up"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "echo second-command"},
  {"op": "key", "value": "Down"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "ec"},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "key", "value": "Delete"},

  {"op": "log", "value": "Tab completes a command, a directory and lists the choices when they differ"},
  {"op": "text", "value": "expor"},
  {"op": "key", "value": "Tab"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "export "},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "key", "value": "Delete"},
  {"op": "text", "value": "cd sr"},
  {"op": "key", "value": "Tab"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "cd src${SEP}"},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "key", "value": "Delete"},
  {"op": "text", "value": "cd s"},
  {"op": "key", "value": "Tab"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "cd s"},
  {"op": "assert_term_contains", "value": "scripts${SEP}  src${SEP}"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_choices.png"},
  {"op": "text", "value": "r"},
  {"op": "key", "value": "Tab"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "cd src${SEP}"},
  {"op": "text", "value": "na"},
  {"op": "key", "value": "Tab"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "cd src${SEP}na"},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "key", "value": "Delete"},
  {"op": "text", "value": "echo src${SEP}na"},
  {"op": "key", "value": "Tab"},
  {"op": "frames", "value": 2},
  {"op": "assert_term_input", "value": "echo src${SEP}nav.lisp "},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_idle", "timeout": 20},
  {"op": "assert_term_contains", "value": "nav.lisp"},
  {"op": "assert_term_history", "value": "echo src${SEP}nav.lisp"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_done.png"},
  {"op": "quit"}
]
