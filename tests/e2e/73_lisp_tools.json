[
  {"op":"log","value":"the Lisp debugger (restarts, frames, their variables, use-value), the inspector, who calls and trace"},
  {"op":"disk_write","path":"${PROJ}/src/tools.lisp","value":"(defun inner (x)\n  (let ((y (* x 2)))\n    (/ y (- x x))))\n\n(defun outer (n)\n  (+ 1 (inner n)))\n\n(defparameter *box* (list 1 \"two\" (vector 3 4)))\n"},
  {"op":"open_project","path":"${PROJ}"},
  {"op":"wait","what":"index"},
  {"op":"open","path":"${PROJ}/src/tools.lisp"},
  {"op":"command","value":"view.repl"},
  {"op":"wait","what":"repl_ready","timeout":60},
  {"op":"command","value":"repl.load_file"},
  {"op":"wait","what":"idle","timeout":60},

  {"op":"log","value":"an error stops: the condition, the restarts, the frames; a frame shows its variables"},
  {"op":"command","value":"repl.focus"},
  {"op":"text","value":"(outer 5)"},
  {"op":"key","value":"Enter"},
  {"op":"wait","what":"lisp_debugger","timeout":30},
  {"op":"frames","value":3},
  {"op":"assert_lisp_debugger","value":"DIVISION-BY-ZERO","level":1,"restart":"abort-to-light","frame":"(OUTER 5)"},
  {"op":"lisp_click","value":"frame:0"},
  {"op":"wait","what":"lisp_locals","timeout":30},
  {"op":"frames","value":2},
  {"op":"assert_lisp_debugger","value":"DIVISION-BY-ZERO","local":"x = 10"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_debugger.png"},
  {"op":"lisp_click","value":"restart:abort-to-light"},
  {"op":"wait","what":"idle","timeout":30},
  {"op":"assert_lisp_debugger","value":"none"},

  {"op":"log","value":"use-value: the value typed is what the unbound variable stands for"},
  {"op":"command","value":"repl.focus"},
  {"op":"text","value":"(+ 1 not-bound-yet)"},
  {"op":"key","value":"Enter"},
  {"op":"wait","what":"lisp_debugger","timeout":30},
  {"op":"frames","value":2},
  {"op":"assert_lisp_debugger","value":"NOT-BOUND-YET","restart":"use-value"},
  {"op":"lisp_debugger_value","value":"41"},
  {"op":"lisp_click","value":"restart:use-value"},
  {"op":"wait","what":"idle","timeout":30},
  {"op":"assert_repl_contains","value":"42"},

  {"op":"log","value":"the inspector goes into the parts of a value and back"},
  {"op":"caret","line":8,"col":16},
  {"op":"command","value":"lisp.inspect"},
  {"op":"wait","what":"inspector","timeout":30},
  {"op":"frames","value":2},
  {"op":"assert_inspector","value":"(1 \"two\" #(3 4))","parts":3,"part":"1 \"two\""},
  {"op":"lisp_click","value":"2"},
  {"op":"frames","value":10},
  {"op":"assert_inspector","value":"#(3 4)","parts":2},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_inspector.png"},
  {"op":"key","value":"Escape"},
  {"op":"frames","value":2},

  {"op":"log","value":"who calls inner: outer, in this file; tracing shows the calls in the REPL"},
  {"op":"caret","line":1,"col":8},
  {"op":"command","value":"lisp.who_calls"},
  {"op":"frames","value":10},
  {"op":"assert_bottom","value":"find"},
  {"op":"assert_find_results","min":1},
  {"op":"command","value":"lisp.trace"},
  {"op":"frames","value":10},
  {"op":"assert_toast","value":"inner"},
  {"op":"command","value":"repl.focus"},
  {"op":"text","value":"(ignore-errors (outer 2))"},
  {"op":"key","value":"Enter"},
  {"op":"wait","what":"idle","timeout":30},
  {"op":"assert_repl_contains","value":"(INNER 2)"},
  {"op":"quit"}
]
