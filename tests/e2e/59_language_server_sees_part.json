[
  {"op": "log", "value": "@fake_clangd_open_only @modules c-cpp: a server that knows only the open files (clangd without a compile_commands.json) - Find Usages adds what the text has elsewhere, and a rename that would leave the name behind is asked about"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "open", "path": "${PROJ}/csrc/main.c"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},

  {"op": "log", "value": "Find Usages: the server's two places in main.c, then util.c and util.h by the text"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 4, "col": 11},
  {"op": "key", "value": "Alt+F7"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_find_results", "min": 4, "title_contains": "and 2 found by the text in 2 file(s) clangd does not see"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_usages.png"},

  {"op": "log", "value": "Rename: asked first; Cancel leaves everything as it was"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 4, "col": 11},
  {"op": "key", "value": "Shift+F6"},
  {"op": "assert_popup", "value": "rename"},
  {"op": "frames", "value": 2},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "sum"},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 2},
  {"op": "wait", "what": "popup", "timeout": 30},
  {"op": "assert_popup", "value": "confirm"},
  {"op": "frames", "value": 1},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_rename.png"},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_text_contains", "value": "  return add(x, 3);"},

  {"op": "log", "value": "Rename Anyway renames what the server found, and nothing else"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 4, "col": 11},
  {"op": "key", "value": "Shift+F6"},
  {"op": "frames", "value": 2},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "sum"},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 2},
  {"op": "wait", "what": "popup", "timeout": 30},
  {"op": "frames", "value": 1},
  {"op": "confirm_accept"},
  {"op": "frames", "value": 2},
  {"op": "assert_toast", "value": "Renamed 2 occurrences in 1 file(s)"},
  {"op": "assert_text_contains", "value": "int x = sum(1, 2);"},
  {"op": "assert_text_contains", "value": "  return sum(x, 3);"},
  {"op": "assert_file_contains", "path": "${PROJ}/csrc/util.h", "value": "int add(int a, int b);"},
  {"op": "quit"}
]
