[
  {"op": "log", "value": "@pictures @full_window: raster images open as pictures, with a bar to zoom them; they are never edited or saved"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "a PNG with a transparent corner: fitted (as it is, being small), then zoomed, then fitted again"},
  {"op": "open", "path": "${PROJ}/media/gradient.png"},
  {"op": "assert_active_file", "value": "gradient.png"},
  {"op": "wait", "what": "picture"},
  {"op": "frames", "value": 4},
  {"op": "assert_picture", "kind": "raster", "width": 96, "height": 64, "shown": true, "error": false, "fitted": true, "zoom": 1.0},
  {"op": "assert_modified", "value": false},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_png.png"},
  {"op": "picture_zoom", "value": 6},
  {"op": "frames", "value": 4},
  {"op": "assert_picture", "fitted": false, "zoom": 6.0},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_png_zoomed.png"},
  {"op": "key", "value": "0"},
  {"op": "frames", "value": 3},
  {"op": "assert_picture", "fitted": true, "zoom": 1.0},
  {"op": "key", "value": "Equals"},
  {"op": "frames", "value": 3},
  {"op": "assert_picture", "fitted": false, "zoom": 1.25},
  {"op": "key", "value": "Minus"},
  {"op": "key", "value": "Minus"},
  {"op": "frames", "value": 3},
  {"op": "assert_picture", "zoom": 0.8},
  {"op": "key", "value": "1"},
  {"op": "frames", "value": 3},
  {"op": "assert_picture", "fitted": false, "zoom": 1.0},

  {"op": "log", "value": "the wheel zooms, a double click goes back to the window's size"},
  {"op": "wheel", "x": 640, "y": 400, "dy": 400},
  {"op": "frames", "value": 6},
  {"op": "assert_picture", "fitted": false},
  {"op": "double_click", "x": 640, "y": 400},
  {"op": "frames", "value": 3},
  {"op": "assert_picture", "fitted": true, "zoom": 1.0},

  {"op": "log", "value": "the other formats"},
  {"op": "open", "path": "${PROJ}/media/photo.jpg"},
  {"op": "wait", "what": "picture"},
  {"op": "assert_picture", "kind": "raster", "width": 80, "height": 60, "shown": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_jpg.png"},
  {"op": "open", "path": "${PROJ}/media/sprite.gif"},
  {"op": "wait", "what": "picture"},
  {"op": "assert_picture", "width": 32, "height": 32, "shown": true},
  {"op": "open", "path": "${PROJ}/media/pixel.bmp"},
  {"op": "wait", "what": "picture"},
  {"op": "assert_picture", "width": 16, "height": 16, "shown": true},
  {"op": "open", "path": "${PROJ}/media/icon.webp"},
  {"op": "wait", "what": "picture"},
  {"op": "assert_picture", "width": 48, "height": 48, "shown": true},
  {"op": "open", "path": "${PROJ}/media/favicon.ico"},
  {"op": "wait", "what": "picture"},
  {"op": "assert_picture", "width": 32, "height": 32, "shown": true},
  {"op": "assert_tabs", "value": 6},

  {"op": "log", "value": "a tiny picture zoomed in shows its pixels as squares"},
  {"op": "open", "path": "${PROJ}/media/pixel.bmp"},
  {"op": "assert_tabs", "value": 6},
  {"op": "picture_zoom", "value": 20},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_pixels.png"},

  {"op": "log", "value": "a file that is not a picture says so, and nothing is lost: saving does not touch picture files"},
  {"op": "open", "path": "${PROJ}/media/fake.png"},
  {"op": "wait", "what": "picture"},
  {"op": "assert_picture", "kind": "raster", "shown": false, "error": true}  ,
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_fake.png"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "frames", "value": 3},
  {"op": "assert_modified", "value": false},

  {"op": "log", "value": "dark and light themes both have a ground and a bar"},
  {"op": "open", "path": "${PROJ}/media/gradient.png"},
  {"op": "command", "value": "view.toggle_theme"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_other_theme.png"},
  {"op": "command", "value": "view.toggle_theme"},

  {"op": "quit"}
]
