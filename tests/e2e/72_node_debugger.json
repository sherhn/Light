[
  {"op":"log","value":"@javascript @modules javascript the real Node.js debugger (vscode-js-debug, downloaded after asking): breakpoints, stepping, variables, the stack, evaluation"},
  {"op":"disk_write","path":"${PROJ}/web/calc.js","value":"function add(a, b) {\n  const sum = a + b;\n  return sum;\n}\n\nfunction total(items) {\n  let t = 0;\n  for (const x of items) {\n    t = add(t, x);\n  }\n  return t;\n}\n\nconst config = { name: 'calc', limits: [1, 2, 3] };\nconsole.log('total is', total(config.limits));\n"},
  {"op":"open_project","path":"${PROJ}"},
  {"op":"wait","what":"index"},
  {"op":"open","path":"${PROJ}/web/calc.js"},
  {"op":"frames","value":3},

  {"op":"log","value":"a click on a line number sets a breakpoint, another clears it; Ctrl+F8 at the caret too"},
  {"op":"gutter_number_click","line":9},
  {"op":"frames","value":2},
  {"op":"gutter_number_click","line":3},
  {"op":"frames","value":2},
  {"op":"assert_breakpoints","value":[3,9]},
  {"op":"gutter_number_click","line":3},
  {"op":"frames","value":2},
  {"op":"caret","line":2},
  {"op":"command","value":"debug.breakpoint"},
  {"op":"frames","value":2},
  {"op":"assert_breakpoints","value":[2,9]},

  {"op":"log","value":"the first debug asks before downloading the adapter"},
  {"op":"command","value":"debug.start"},
  {"op":"frames","value":3},
  {"op":"assert_popup","value":"confirm"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_ask.png"},
  {"op":"confirm_accept"},
  {"op":"frames","value":2},
  {"op":"assert_bottom","value":"debug"},
  {"op":"wait","what":"debug_paused","timeout":120},
  {"op":"frames","value":3},
  {"op":"assert_debug","value":"paused","line":9,"function":"total"},
  {"op":"assert_debug_variable","name":"t","value":"0"},
  {"op":"assert_debug_variable","name":"x","value":"1"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_paused.png"},

  {"op":"log","value":"Step Into goes into add; its arguments are there"},
  {"op":"debug_button","value":"stepIn"},
  {"op":"frames","value":2},
  {"op":"wait","what":"debug_paused","timeout":30},
  {"op":"assert_debug","value":"paused","line":2,"function":"add"},
  {"op":"assert_debug_variable","name":"a","value":"0"},
  {"op":"assert_debug_variable","name":"b","value":"1"},
  {"op":"debug_eval","value":"a + b * 100"},
  {"op":"frames","value":2},
  {"op":"wait","what":"debug_console","value":"100","timeout":30},
  {"op":"assert_debug_console","value":"100"},

  {"op":"log","value":"Step Over and Step Out"},
  {"op":"debug_button","value":"next"},
  {"op":"frames","value":2},
  {"op":"wait","what":"debug_paused","timeout":30},
  {"op":"assert_debug","value":"paused","line":3,"function":"add"},
  {"op":"assert_debug_variable","name":"sum","value":"1"},
  {"op":"debug_button","value":"stepOut"},
  {"op":"frames","value":2},
  {"op":"wait","what":"debug_paused","timeout":30},
  {"op":"assert_debug","value":"paused","function":"total"},

  {"op":"log","value":"a breakpoint cleared while it runs is not hit again; the program ends with its output"},
  {"op":"gutter_number_click","line":9},
  {"op":"frames","value":2},
  {"op":"gutter_number_click","line":2},
  {"op":"frames","value":2},
  {"op":"assert_breakpoints","value":[]},
  {"op":"debug_button","value":"continue"},
  {"op":"frames","value":2},
  {"op":"wait","what":"debug_idle","timeout":60},
  {"op":"assert_debug_console","value":"total is 6"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_ended.png"},

  {"op":"log","value":"debugging again needs no download; Stop ends the program"},
  {"op":"gutter_number_click","line":7},
  {"op":"frames","value":2},
  {"op":"command","value":"debug.start"},
  {"op":"frames","value":2},
  {"op":"assert_popup","value":"none"},
  {"op":"wait","what":"debug_paused","timeout":60},
  {"op":"assert_debug","value":"paused","line":7},
  {"op":"debug_button","value":"stop"},
  {"op":"frames","value":3},
  {"op":"wait","what":"debug_idle","timeout":30},
  {"op":"assert_debug_console","value":"Debugging ended"},
  {"op":"quit"}
