  {"op": "frames", "value": 6},
  {"op": "assert_modules", "installed": ["css", "html"], "enabled": ["css", "html"]},
  {"op": "assert_empty_directory", "path": "${PROJ}_new/web-demo"},
  {"op": "command", "value": "file.new"},
