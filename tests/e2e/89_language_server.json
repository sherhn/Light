[
  {"op": "log", "value": "@fake_clangd @modules c-cpp: a language server (a fake clangd) answers Go to Declaration, Find Usages, hover, completion, Rename and Reformat Code; its problems show in the code as it changes"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "open", "path": "${PROJ}/csrc/main.c"},
  {"op": "assert_language", "value": "c"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_max_problems", "value": 0},

  {"op": "log", "value": "the server's problems follow the text, without a save"},
  {"op": "set_text", "value": "#include \"util.h\"\nconst char *s = \"привет\"; int x = add(1, 2);\nint main(void) {\n  return add(x, missing);\n}\n"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_problem", "value": "use of undeclared identifier 'missing'", "line": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_problem.png"},
  {"op": "set_text", "value": "#include \"util.h\"\nconst char *s = \"привет\"; int x = add(1, 2);\nint main(void) {\n  return add(x, 3);\n}\n"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_max_problems", "value": 0},

  {"op": "log", "value": "Go to Declaration: after letters that are 2 bytes in UTF-8 but 1 unit in UTF-16"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 2, "col": 36},
  {"op": "key", "value": "Ctrl+B"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_active_file", "value": "util.c"},
  {"op": "assert_caret", "line": 2, "col": 5},
  {"op": "key", "value": "Ctrl+Alt+Left"},
  {"op": "assert_active_file", "value": "main.c"},

  {"op": "log", "value": "Find Usages: the server's places in every file"},
  {"op": "caret", "line": 4, "col": 11},
  {"op": "key", "value": "Alt+F7"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_find_results", "min": 4},
  {"op": "assert_bottom", "value": "find"},

  {"op": "log", "value": "the hover popup says what the server says"},
  {"op": "hover_on", "value": "add(x"},
  {"op": "wait", "what": "hover", "timeout": 10},
  {"op": "assert_hover", "title": "add", "kind": "function", "contains": "From the fake server"},
  {"op": "assert_hover", "contains": "int add(int a, int b)"},
  {"op": "hover_off"},

  {"op": "log", "value": "completion after `.` comes from the server alone"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 3, "col": 17},
  {"op": "key", "value": "Enter"},
  {"op": "text", "value": "s."},
  {"op": "wait", "what": "completion", "timeout": 10},
  {"op": "assert_completion", "value": "x"},
  {"op": "assert_completion", "value": "y"},
  {"op": "key", "value": "Escape"},

  {"op": "log", "value": "Rename (Shift+F6): open files in the editor, the others on disk"},
  {"op": "set_text", "value": "#include \"util.h\"\nconst char *s = \"привет\"; int x = add(1, 2);\nint main(void) {\n  return add(x, 3);\n}\n"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "focus_editor"},
  {"op": "caret", "line": 4, "col": 11},
  {"op": "key", "value": "Shift+F6"},
  {"op": "assert_popup", "value": "rename"},
  {"op": "frames", "value": 2},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "sum"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_toast", "value": "Renamed 4 occurrences in 3 file(s)"},
  {"op": "assert_text_contains", "value": "int x = sum(1, 2);"},
  {"op": "assert_text_contains", "value": "  return sum(x, 3);"},
  {"op": "assert_file_contains", "path": "${PROJ}/csrc/util.h", "value": "int sum(int a, int b);"},
  {"op": "open", "path": "${PROJ}/csrc/util.c"},
  {"op": "assert_text_contains", "value": "int sum(int a, int b) { return a + b; }"},
  {"op": "open", "path": "${PROJ}/csrc/main.c"},

  {"op": "log", "value": "Reformat Code (Ctrl+Alt+L) is the server's formatting"},
  {"op": "set_text", "value": "int  main( void ){return 0;}\n"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "focus_editor"},
  {"op": "key", "value": "Ctrl+Alt+L"},
  {"op": "wait", "what": "lsp_idle", "timeout": 30},
  {"op": "assert_text", "value": "int main(void) {return 0;}\n"},

  {"op": "log", "value": "closing the project stops the server"},
  {"op": "command", "value": "file.save_all"},
  {"op": "close_project"},
  {"op": "wait", "what": "file_contains", "path": "${PROJ}/../fake-lsp.log", "value": "<- exit", "timeout": 10},
  {"op": "quit"}
]
