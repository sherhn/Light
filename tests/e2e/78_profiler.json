  {"op":"log","value":"@javascript @modules javascript a real Node.js CPU profile as a flame graph and the hot functions"},
  {"op":"disk_write","path":"${PROJ}/web/busy.js","value":"function fib(n) {\n  return n < 2 ? n : fib(n - 1) + fib(n - 2);\n}\n\nfunction slow() {\n  let s = 0;\n  for (let i = 0; i < 4e7; i++) s += Math.sqrt(i);\n  return s;\n}\n\nfunction main() {\n  const until = performance.now() + 800;\n  let answer;\n  do { answer = [fib(32), Math.round(slow())]; } while (performance.now() < until);\n  console.log('result', ...answer);\n}\n\nmain();\n"},
