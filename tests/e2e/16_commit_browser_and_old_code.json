[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "focus_editor"},

  {"op": "log", "value": "two local commits with different code"},
  {"op": "set_text", "value": "(defun alpha (x)\n  (* x 3))\n\n(defun beta (y)\n  (alpha y))\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "key", "value": "Ctrl+Alt+K"},
  {"op": "assert_popup", "value": "local_commit"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "round one"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_local_commits", "value": 1},

  {"op": "focus_editor"},
  {"op": "set_text", "value": "(defun alpha (x)\n  (* x 4))\n\n(defun beta (y)\n  (alpha y))\n(defun gamma () 1)\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "key", "value": "Ctrl+Alt+K"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "round two"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_local_commits", "value": 2},

  {"op": "log", "value": "browse commit 2: what it changed, then its code"},
  {"op": "open_local_commit", "value": 2},
  {"op": "frames", "value": 4},
  {"op": "assert_popup", "value": "local_view"},
  {"op": "assert_local_view", "commit": 2, "files": 1, "value": "-  (* x 3))"},
  {"op": "assert_local_view", "value": "+  (* x 4))"},
  {"op": "assert_local_view", "value": "+(defun gamma () 1)"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_commit2_changes.png"},
  {"op": "local_view", "mode": "code"},
  {"op": "frames", "value": 4},
  {"op": "assert_local_view", "value": "(defun gamma () 1)"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_commit2_code.png"},

  {"op": "log", "value": "switch to commit 1 with the arrow keys / navigation"},
  {"op": "key", "value": "Left"},
  {"op": "frames", "value": 4},
  {"op": "assert_local_view", "commit": 1, "value": "(* x 3))"},
  {"op": "local_view", "mode": "changes"},
  {"op": "frames", "value": 3},
  {"op": "assert_local_view", "value": "-  (* x 2))"},
  {"op": "assert_local_view", "value": "+  (* x 3))"},
  {"op": "key", "value": "Right"},
  {"op": "frames", "value": 3},
  {"op": "assert_local_view", "commit": 2},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},

  {"op": "log", "value": "roll the single file back to commit 1, then the whole tree"},
  {"op": "local_restore", "value": 1, "file": "src/nav.lisp"},
  {"op": "frames", "value": 4},
  {"op": "assert_file_contains", "path": "${PROJ}/src/nav.lisp", "value": "(* x 3)"},
  {"op": "local_restore", "value": 2},
  {"op": "frames", "value": 4},
  {"op": "assert_file_contains", "path": "${PROJ}/src/nav.lisp", "value": "(defun gamma () 1)"},

  {"op": "compare_snapshot", "value": 2},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "log", "value": "clicking a change marker shows the old code in a small window"},
  {"op": "focus_editor"},
  {"op": "set_text", "value": "(defun alpha (x)\n  (* x 5))\n\n(defun beta (y)\n  (alpha y))\n(defun gamma () 1)\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "assert_marks", "exact": 1},
  {"op": "gutter_click", "line": 2},
  {"op": "frames", "value": 4},
  {"op": "assert_hunk_popup", "value": "(* x 4))", "old_lines": 1},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_old_code_popup.png"},
  {"op": "gutter_click", "line": 2},
  {"op": "frames", "value": 4},
  {"op": "assert_hunk_popup", "none": true},

  {"op": "log", "value": "revert just that block"},
  {"op": "gutter_click", "line": 2},
  {"op": "frames", "value": 4},
  {"op": "assert_hunk_popup", "value": "(* x 4))"},
  {"op": "hunk_revert"},
  {"op": "frames", "value": 3},
  {"op": "assert_hunk_popup", "none": true},
  {"op": "assert_text", "value": "(defun alpha (x)\n  (* x 4))\n\n(defun beta (y)\n  (alpha y))\n(defun gamma () 1)\n"},
  {"op": "assert_marks", "exact": 0},
  {"op": "quit"}
]
