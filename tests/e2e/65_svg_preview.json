[
  {"op": "log", "value": "@pictures @full_window: an SVG is code with its drawing beside it, redrawn as the code changes, in the three modes of a document"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},

  {"op": "open", "path": "${PROJ}/media/logo.svg"},
  {"op": "assert_active_file", "value": "logo.svg"},
  {"op": "wait", "what": "picture"},
  {"op": "frames", "value": 4},
  {"op": "assert_preview", "mode": "split"},
  {"op": "assert_picture", "kind": "svg", "width": 200, "height": 80, "shown": true, "error": false, "fitted": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_split.png"},

  {"op": "log", "value": "the drawing only: nothing receives typing; zoomed in it is drawn again, sharp"},
  {"op": "command", "value": "view.preview_only"},
  {"op": "frames", "value": 4},
  {"op": "assert_preview", "mode": "preview"},
  {"op": "text", "value": "typed into the void"},
  {"op": "frames", "value": 2},
  {"op": "assert_modified", "value": false},
  {"op": "wait", "what": "picture"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_only.png"},
  {"op": "picture_zoom", "value": 5},
  {"op": "wait", "what": "picture"},
  {"op": "frames", "value": 4},
  {"op": "assert_picture", "fitted": false, "zoom": 5.0, "shown": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_zoomed.png"},
  {"op": "picture_zoom", "value": "fit"},

  {"op": "log", "value": "the code only"},
  {"op": "command", "value": "view.preview_code"},
  {"op": "frames", "value": 4},
  {"op": "assert_preview", "mode": "code"},

  {"op": "log", "value": "an edit changes the drawing; broken code keeps the last drawing and says what is wrong"},
  {"op": "command", "value": "view.preview_split"},
  {"op": "set_text", "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"60\"><rect width=\"120\" height=\"60\" fill=\"#2b8a3e\"/><circle cx=\"30\" cy=\"30\" r=\"20\" fill=\"#fff\"/></svg>"},
  {"op": "wait", "what": "picture"},
  {"op": "frames", "value": 4},
  {"op": "assert_picture", "width": 120, "height": 60, "shown": true, "error": false},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_edited.png"},
  {"op": "set_text", "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"120\" height=\"60\"><rect width=\"120\" height=\"60\" fill=\"#2b8a3e\"/"},
  {"op": "wait", "what": "picture"},
  {"op": "frames", "value": 4},
  {"op": "assert_picture", "width": 120, "height": 60, "shown": true, "error": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_error.png"},

  {"op": "log", "value": "an SVG that was broken from the start has no drawing, only the reason"},
  {"op": "open", "path": "${PROJ}/media/broken.svg"},
  {"op": "wait", "what": "picture"},
  {"op": "frames", "value": 4},
  {"op": "assert_picture", "kind": "svg", "shown": false, "error": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_broken.png"},

  {"op": "log", "value": "other files still have no preview"},
  {"op": "open", "path": "${PROJ}/src/hello.lisp"},
  {"op": "assert_preview", "mode": "none"},
  {"op": "command", "value": "view.preview_only"},
  {"op": "assert_toast", "value": "Only Markdown, reStructuredText and SVG"},

  {"op": "quit"}
]
