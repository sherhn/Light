[
  {"op": "log", "value": "@modules python,assembler: New File offers a file of any name and one kind per module that is on"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "key", "value": "Alt+Insert"},
  {"op": "assert_popup", "value": "new_file"},
  {"op": "assert_new_file_kinds", "value": ["", "Assembler", "Lisp", "Python"]},
  {"op": "assert_new_file", "kind": 0, "extension": ""},

  {"op": "log", "value": "a Python file: the name is typed, .py is added (shown dim while typing)"},
  {"op": "new_file_kind", "value": "Python"},
  {"op": "text", "value": "tool"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_python.png"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Enter"},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_active_file", "value": "tool.py"},
  {"op": "assert_language", "value": "python"},

  {"op": "log", "value": "the arrows pick the kind; a name with its extension keeps it"},
  {"op": "key", "value": "Alt+Insert"},
  {"op": "key", "value": "Down"},
  {"op": "assert_new_file", "kind": 1, "extension": "asm"},
  {"op": "key", "value": "Up"},
  {"op": "key", "value": "Up"},
  {"op": "assert_new_file", "kind": 3, "extension": "py"},
  {"op": "text", "value": "setup.pyw"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_active_file", "value": "setup.pyw"},

  {"op": "log", "value": "assembler offers its two languages' extensions"},
  {"op": "key", "value": "Alt+Insert"},
  {"op": "new_file_set", "value": "boot", "extension": "s"},
  {"op": "assert_new_file", "kind": 1, "extension": "s"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_assembler.png"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Enter"},
  {"op": "assert_active_file", "value": "boot.s"},

  {"op": "log", "value": "a file of any name is made as typed"},
  {"op": "key", "value": "Alt+Insert"},
  {"op": "text", "value": "notes"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_active_file", "value": "notes"},
  {"op": "assert_project_file", "value": "tool.py"},
  {"op": "assert_project_file", "value": "boot.s"},
  {"op": "quit"}
]
