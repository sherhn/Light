[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},

  {"op": "log", "value": ".gitignore is honoured by the tree, search and go-to-file"},
  {"op": "assert_ignored", "value": "src/skip.fasl"},
  {"op": "assert_ignored", "value": "build", "dir": true},
  {"op": "assert_ignored", "value": "src/nav.lisp", "ignored": false},
  {"op": "assert_project_file", "value": "src/nav.lisp"},
  {"op": "assert_project_file", "value": "src/skip.fasl", "present": false},
  {"op": "assert_project_file", "value": "build/out.txt", "present": false},

  {"op": "log", "value": "work on top of an upstream repo: save a snapshot, then explicitly select it for comparison"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "caret", "line": 1, "col": 1},
  {"op": "text", "value": ";; round one"},
  {"op": "key", "value": "Enter"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "assert_git_changes", "value": 1},
  {"op": "assert_marks", "min": 1},
  {"op": "assert_base", "value": "head"},

  {"op": "key", "value": "Ctrl+Alt+K"},
  {"op": "assert_popup", "value": "local_commit"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "round one"},
  {"op": "key", "value": "Enter"},
  {"op": "assert_popup", "value": "none"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "assert_local_commits", "value": 1},
  {"op": "assert_base", "value": "head"},
  {"op": "assert_git_changes", "value": 1},
  {"op": "assert_marks", "min": 1},
  {"op": "compare_snapshot", "value": 1},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "assert_base", "value": "local"},
  {"op": "assert_git_changes", "value": 0},
  {"op": "assert_marks", "exact": 0},

  {"op": "log", "value": "new edits show up relative to the checkpoint only"},
  {"op": "focus_editor"},
  {"op": "caret", "line": 1, "col": 1},
  {"op": "text", "value": ";; round two"},
  {"op": "key", "value": "Enter"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "assert_git_changes", "value": 1},
  {"op": "assert_marks", "exact": 1},
  {"op": "key", "value": "Alt+9"},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_changes_vs_local.png"},

  {"op": "log", "value": "git itself is untouched: HEAD shows both rounds again"},
  {"op": "command", "value": "git.reset_base"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "assert_base", "value": "head"},
  {"op": "assert_git_changes", "value": 1},
  {"op": "assert_marks", "min": 2},
  {"op": "assert_git_log", "value": "initial commit"},
  {"op": "assert_local_commits", "value": 1},

  {"op": "log", "value": "the local store is invisible to git"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "assert_git_changes", "value": 1},
  {"op": "quit"}
]
