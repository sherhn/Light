[
  {"op": "log", "value": "@full_window @path_completion Real address field: Tab, spaces, relative path and keyboard focus"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "command", "value": "file.open_project"},
  {"op": "wait", "what": "project_browser_idle", "timeout": 20},
  {"op": "project_browser", "go": "${PROJ}"},
  {"op": "wait", "what": "project_browser_idle", "timeout": 20},
  {"op": "key", "value": "Ctrl+L"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "${PROJ}/My Pr"},
  {"op": "key", "value": "Tab"},
  {"op": "wait", "what": "path_input", "value": "${PROJ}/My Projects/", "timeout": 10},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_spaces.png"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "project_browser_idle", "timeout": 20},
  {"op": "assert_project_browser", "current": "/My Projects"},
  {"op": "key", "value": "Ctrl+L"},
  {"op": "frames", "value": 3},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "../sr"},
  {"op": "key", "value": "Tab"},
  {"op": "wait", "what": "path_input", "value": "../src/", "timeout": 10},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "project_browser_idle", "timeout": 20},
  {"op": "assert_project_browser", "current": "/src", "contains": ["nav.lisp"]},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_relative.png"},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},
  {"op": "quit"}
]
