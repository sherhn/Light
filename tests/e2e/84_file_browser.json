[
  {"op": "log", "value": "File browser selects files and opens them with the real UI button"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "command", "value": "file.browse_files"},
  {"op": "project_browser", "side": "local", "go": "${PROJ}/src"},
  {"op": "wait", "what": "project_browser_idle", "timeout": 20},
  {"op": "assert_project_browser", "side": "local", "contains": ["nav.lisp"]},
  {"op": "project_browser", "select": "nav.lisp"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_browser.png"},
  {"op": "file_browser_button", "value": "Open in IDE"},
  {"op": "assert_popup", "value": "none"},
  {"op": "assert_text_contains", "value": "(defun alpha"},
  {"op": "copy_file", "path": "${PROJ}/src/nav.lisp", "destination": "${CFG}"},
  {"op": "wait", "what": "file_transfer_idle", "timeout": 20},
  {"op": "assert_file_copy"},
  {"op": "assert_file_contains", "path": "${CFG}/nav.lisp", "value": "(defun alpha"},
  {"op": "assert_file_contains", "path": "${PROJ}/src/nav.lisp", "value": "(defun alpha"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_copied.png"},
  {"op": "copy_file", "path": "${PROJ}/src/nav.lisp", "destination": "${CFG}"},
  {"op": "wait", "what": "file_transfer_idle", "timeout": 20},
  {"op": "assert_file_copy", "error": "Already exists"},
  {"op": "quit"}
]
