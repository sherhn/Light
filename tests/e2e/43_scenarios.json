[
  {"op": "log", "value": "a scenario: console commands one after another, picked in the run list"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "open", "path": "${PROJ}/src/main.lisp"},
  {"op": "scenario", "value": "all ok", "commands": ["echo first", "# a comment", "echo second", "echo third"]},
  {"op": "select_run", "value": "scenario:all ok"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "assert_run_contains", "value": "[1/3] echo first"},
  {"op": "assert_run_contains", "value": "second"},
  {"op": "assert_run_contains", "value": "[3/3] echo third"},
  {"op": "assert_run_contains", "value": "Scenario all ok finished"},
  {"op": "assert_bottom", "value": "run"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_run.png"},

  {"op": "log", "value": "a command that fails stops the scenario, unless it is told to go on"},
  {"op": "scenario", "value": "stops", "commands": ["echo before", "exit 3", "echo never"]},
  {"op": "select_run", "value": "scenario:stops"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "assert_run_contains", "value": "before"},
  {"op": "assert_run_contains", "value": "stopped at command 2 of 3"},
  {"op": "assert_run_lacks", "value": "never"},
  {"op": "scenario", "value": "goes on", "commands": ["echo before", "exit 3", "echo still"], "stop": false},
  {"op": "select_run", "value": "scenario:goes on"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "assert_run_contains", "value": "still"},
  {"op": "assert_run_contains", "value": "Scenario goes on finished"},

  {"op": "log", "value": "{file}, {dir}, {name} and {stem} are the file that is open"},
  {"op": "scenario", "value": "names", "commands": ["echo {name} {stem}"]},
  {"op": "select_run", "value": "scenario:names"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 30},
  {"op": "assert_run_contains", "value": "main.lisp main"},

  {"op": "log", "value": "the scenarios are kept with the project and edited in a dialog"},
  {"op": "assert_project_config", "path": "${PROJ}", "value": "goes on"},
  {"op": "command", "value": "run.scenarios"},
  {"op": "frames", "value": 4},
  {"op": "assert_popup", "value": "scenarios"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_dialog.png"},
  {"op": "key", "value": "Escape"},
  {"op": "frames", "value": 3},
  {"op": "assert_popup", "value": "none"},
  {"op": "quit"}
]
