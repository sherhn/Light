[
  {"op": "log", "value": "@no_modules @polyglot: a fresh Light has no languages; they are downloaded from inside the IDE"},
  {"op": "assert_modules", "installed": [], "tab": false},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "open", "path": "${PROJ}/tools/demo.py"},
  {"op": "assert_language", "value": "plain"},
  {"op": "frames", "value": 4},

  {"op": "log", "value": "the Modules tab lists what the registry offers, with covers"},
  {"op": "command", "value": "app.modules"},
  {"op": "wait", "what": "modules_index", "timeout": 30},
  {"op": "wait", "what": "modules_idle", "timeout": 30},
  {"op": "frames", "value": 12},
  {"op": "assert_modules", "tab": true, "needed": ["lisp", "python", "markdown", "restructuredtext", "c-cpp", "assembler"]},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_page.png"},
  {"op": "wheel", "x": 800, "y": 500, "dy": -430},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_cards.png"},
  {"op": "wheel", "x": 800, "y": 500, "dy": 430},
  {"op": "frames", "value": 4},

  {"op": "log", "value": "install Python: the .py file is now read as Python"},
  {"op": "module_install", "value": "python"},
  {"op": "wait", "what": "modules_idle", "timeout": 60},
  {"op": "frames", "value": 6},
  {"op": "assert_modules", "installed": ["python"], "enabled": ["python"], "needed": ["lisp", "markdown", "restructuredtext", "c-cpp", "assembler"]},
  {"op": "open", "path": "${PROJ}/tools/demo.py"},
  {"op": "assert_language", "value": "python"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_python.png"},

  {"op": "log", "value": "switch it off and on again"},
  {"op": "module_enable", "value": "python", "on": false},
  {"op": "frames", "value": 3},
  {"op": "assert_language", "value": "plain"},
  {"op": "assert_modules", "installed": ["python"], "enabled": []},
  {"op": "module_enable", "value": "python", "on": true},
  {"op": "frames", "value": 3},
  {"op": "assert_language", "value": "python"},

  {"op": "log", "value": "install several: the languages of the files that are open follow"},
  {"op": "module_install", "value": "markdown"},
  {"op": "module_install", "value": "c-cpp"},
  {"op": "wait", "what": "modules_idle", "timeout": 60},
  {"op": "frames", "value": 6},
  {"op": "open", "path": "${PROJ}/docs/notes.md"},
  {"op": "assert_language", "value": "markdown"},
  {"op": "open", "path": "${PROJ}/native/main.c"},
  {"op": "assert_language", "value": "c"},
  {"op": "command", "value": "app.modules"},
  {"op": "frames", "value": 10},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_installed.png"},

  {"op": "log", "value": "remove it: back to plain text"},
  {"op": "module_remove", "value": "python"},
  {"op": "wait", "what": "modules_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_modules", "installed": ["c-cpp", "markdown"]},
  {"op": "open", "path": "${PROJ}/tools/demo.py"},
  {"op": "assert_language", "value": "plain"},

  {"op": "log", "value": "the registry can be named in Settings"},
  {"op": "command", "value": "app.settings"},
  {"op": "settings_page", "value": 4},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_settings.png"},
  {"op": "key", "value": "Escape"},
  {"op": "quit"}
]
