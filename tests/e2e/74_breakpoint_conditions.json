[
  {"op":"log","value":"@javascript @modules javascript breakpoints with a condition, a hit count or a message to log, edited from a right click on the line number"},
  {"op":"disk_write","path":"${PROJ}/web/calc.js","value":"function add(a, b) {\n  const sum = a + b;\n  return sum;\n}\n\nfunction total(items) {\n  let t = 0;\n  for (const x of items) {\n    t = add(t, x);\n  }\n  return t;\n}\n\nconsole.log('total is', total([1, 2, 3, 4]));\n"},
  {"op":"open_project","path":"${PROJ}"},
  {"op":"wait","what":"index"},
  {"op":"open","path":"${PROJ}/web/calc.js"},
  {"op":"frames","value":3},

  {"op":"log","value":"a right click opens the editor; a condition makes the dot hollow, a message makes it a diamond"},
  {"op":"gutter_number_click","line":9,"right":true},
  {"op":"frames","value":3},
  {"op":"breakpoint_editor_set","condition":"x === 3"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_editor.png"},
  {"op":"debug_click","value":"done"},
  {"op":"frames","value":2},
  {"op":"assert_breakpoint","line":9,"value":"conditional","condition":"x === 3"},
  {"op":"gutter_number_click","line":3,"right":true},
  {"op":"frames","value":3},
  {"op":"breakpoint_editor_set","log":"sum is {sum}"},
  {"op":"debug_click","value":"done"},
  {"op":"frames","value":2},
  {"op":"assert_breakpoint","line":3,"value":"log","log":"sum is {sum}"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_marks.png"},

  {"op":"log","value":"it stops only when x is 3; the logpoint logged each sum without stopping"},
  {"op":"command","value":"debug.start"},
  {"op":"frames","value":3},
  {"op":"confirm_accept"},
  {"op":"wait","what":"debug_paused","timeout":120},
  {"op":"frames","value":3},
  {"op":"assert_debug","value":"paused","line":9,"function":"total"},
  {"op":"assert_debug_variable","name":"x","value":"3"},
  {"op":"assert_debug_variable","name":"t","value":"3"},
  {"op":"assert_debug_console","value":"sum is 1"},
  {"op":"assert_debug_console","value":"sum is 3"},
  {"op":"log","value":"js-debug has no disassembly or memory: only the variables are offered"},
  {"op":"debug_click","value":"variables"},
  {"op":"debug_button","value":"continue"},
  {"op":"frames","value":2},
  {"op":"wait","what":"debug_idle","timeout":60},
  {"op":"assert_debug_console","value":"sum is 10"},
  {"op":"assert_debug_console","value":"total is 10"},

  {"op":"log","value":"a hit count: the second call of add stops; Remove takes the breakpoint away"},
