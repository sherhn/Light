[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "the GitHub tab starts with a sign-in form"},
  {"op": "command", "value": "file.clone"},
  {"op": "assert_popup", "value": "clone"},
  {"op": "frames", "value": 3},
  {"op": "clone_tab", "value": "github"},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "signed_in": false, "listing": "none"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_1_sign_in.png"},

  {"op": "log", "value": "sign in in the browser: waiting can be cancelled, a failure is explained, then it works"},
  {"op": "github_sign_in_browser"},
  {"op": "frames", "value": 6},
  {"op": "assert_github", "signed_in": false, "waiting": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_1b_waiting_for_browser.png"},
  {"op": "wait", "what": "file_contains", "path": "${PROJ}/../fake-gcm.json", "value": "\"calls\": 1", "timeout": 10},
  {"op": "github_cancel_browser"},
  {"op": "wait", "what": "github_idle", "timeout": 30},
  {"op": "assert_github", "signed_in": false, "waiting": false, "no_login_error": true},
  {"op": "github_sign_in_browser"},
  {"op": "wait", "what": "github_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "signed_in": false, "login_error_contains": "browser could not be opened"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_1c_browser_failed.png"},
  {"op": "github_sign_in_browser"},
  {"op": "wait", "what": "github_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "signed_in": true, "listing": "mine", "login": "octocat", "repos": 5, "no_login_error": true},
  {"op": "github_sign_out"},
  {"op": "assert_github", "signed_in": false, "listing": "none"},

  {"op": "log", "value": "a wrong token is refused with an explanation"},
  {"op": "github_sign_in", "value": "ghp_wrong"},
  {"op": "wait", "what": "github_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "signed_in": false, "error_contains": "rejected"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_2_wrong_token.png"},

  {"op": "log", "value": "public repositories of any user work without signing in"},
  {"op": "github_show_user", "value": "nobody-here"},
  {"op": "wait", "what": "github_idle", "timeout": 30},
  {"op": "assert_github", "error_contains": "No such GitHub user"},
  {"op": "github_show_user", "value": "octocat"},
  {"op": "wait", "what": "github_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "signed_in": false, "listing": "user:octocat", "login": "octocat", "repos": 3, "no_error": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_3_public.png"},

  {"op": "log", "value": "sign in with the token: the account and all its repositories, private ones included"},
  {"op": "github_sign_out"},
  {"op": "github_sign_in", "value": "${GH_TOKEN}"},
  {"op": "wait", "what": "github_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "signed_in": true, "listing": "mine", "login": "octocat", "repos": 5, "visible": 5, "no_error": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_4_my_repos.png"},

  {"op": "log", "value": "search and the forks / archived switches"},
  {"op": "github_filter", "value": "lisp"},
  {"op": "assert_github", "visible": 2},
  {"op": "github_filter", "value": "", "forks": false},
  {"op": "assert_github", "visible": 4},
  {"op": "github_filter", "value": "", "forks": false, "archived": false},
  {"op": "assert_github", "visible": 3},
  {"op": "github_filter", "value": "nothing like this", "forks": true, "archived": true},
  {"op": "assert_github", "visible": 0},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_5_no_match.png"},
  {"op": "github_filter", "value": ""},
  {"op": "frames", "value": 4},

  {"op": "log", "value": "a click picks a repository, a double click clones it and opens the project"},
  {"op": "github_click", "value": "octocat/lisp-demo"},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "selected": "octocat/lisp-demo"},
  {"op": "clone_set", "dir": "${PROJ}_clones"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_6_selected.png"},
  {"op": "github_click", "value": "octocat/lisp-demo", "double": true},
  {"op": "wait", "what": "ask_open", "timeout": 60},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "no_popup", "timeout": 60},
  {"op": "wait", "what": "index"},
  {"op": "assert_project_file", "value": "src/main.lisp"},
  {"op": "assert_project_file", "value": "README.md"},

  {"op": "log", "value": "the session survives: reopen the dialog and clone the private repository"},
  {"op": "command", "value": "file.clone"},
  {"op": "assert_popup", "value": "clone"},
  {"op": "frames", "value": 3},
  {"op": "clone_tab", "value": "github"},
  {"op": "frames", "value": 4},
  {"op": "assert_github", "signed_in": true, "repos": 5},
  {"op": "clone_set", "dir": "${PROJ}_clones"},
  {"op": "github_click", "value": "octocat/private-notes", "double": true},
  {"op": "wait", "what": "ask_open", "timeout": 60},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "no_popup", "timeout": 60},
  {"op": "wait", "what": "index"},
  {"op": "assert_project_file", "value": "notes.txt"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_7_cloned_private.png"},

  {"op": "log", "value": "sign out forgets the session"},
  {"op": "github_sign_out"},
  {"op": "assert_github", "signed_in": false, "listing": "none", "repos": 0},
  {"op": "quit"}
]
