[
  {"op": "log", "value": "@http_server @modules http requests of a .http file are sent from the gutter; responses are readable in the Run window"},
  {"op": "disk_write", "path": "${PROJ}/api/requests.http", "value": "@base = ${HTTP}\n\n### Hello\nGET {{base}}/hello\n    ?name=light\nAccept: application/json\n\n### Echo\nPOST {{base}}/echo\nContent-Type: application/json\nX-Token: {{token}}\n\n{\"id\": \"{{$uuid}}\", \"note\": \"from Light\"}\n\n###\nGET {{base}}/moved\n\n###\nGET {{base}}/missing\n\n###\nGET {{base}}/{{undefined_thing}}\n"},
  {"op": "disk_write", "path": "${PROJ}/api/http-client.env.json", "value": "{\"dev\":{\"token\":\"dev-token\"},\"prod\":{\"token\":\"prod-token\"}}"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "open", "path": "${PROJ}/api/requests.http"},
  {"op": "assert_language", "value": "http"},
  {"op": "frames", "value": 3},
  {"op": "assert_gutter_icons", "value": [[4, "play"], [9, "play"], [16, "play"], [19, "play"], [22, "play"]]},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_file.png"},
  {"op": "log", "value": "a GET: the multi-line query reaches the server; the JSON comes back indented"},
  {"op": "gutter_icon_click", "line": 4},
  {"op": "frames", "value": 3},
  {"op": "gutter_menu_click", "value": "Send 'Hello'"},
  {"op": "frames", "value": 2},
  {"op": "wait", "what": "run_done", "timeout": 60},
  {"op": "frames", "value": 2},
  {"op": "assert_run_contains", "value": "HTTP/1.0 200 OK"},
  {"op": "assert_run_contains", "value": "\"name\": \"light\""},
  {"op": "assert_run_contains", "value": "Content-Type: application/json"},
  {"op": "assert_run_tabs", "value": ["HTTP Hello"], "active": "HTTP Hello"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_get.png"},
  {"op": "log", "value": "a POST with an environment: the variable comes from http-client.env.json, the body is sent as written"},
  {"op": "gutter_icon_click", "line": 9},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_menu.png"},
  {"op": "gutter_menu_click", "value": "Send with 'prod'"},
  {"op": "frames", "value": 2},
  {"op": "wait", "what": "run_done", "timeout": 60},
  {"op": "frames", "value": 2},
  {"op": "assert_run_contains", "value": "\"token\": \"prod-token\""},
  {"op": "assert_run_contains", "value": "from Light"},
  {"op": "assert_run_contains", "value": "\"method\": \"POST\""},
  {"op": "log", "value": "redirects are followed; an error status turns the tab red"},
  {"op": "caret", "line": 16},
  {"op": "frames", "value": 15},
  {"op": "gutter_icon_click", "line": 16},
  {"op": "frames", "value": 3},
  {"op": "gutter_menu_click", "value": "Send 'GET /moved'"},
  {"op": "frames", "value": 2},
  {"op": "wait", "what": "run_done", "timeout": 60},
  {"op": "frames", "value": 2},
  {"op": "assert_run_contains", "value": "\"from\": \"redirect\""},
  {"op": "caret", "line": 19},
  {"op": "frames", "value": 15},
  {"op": "gutter_icon_click", "line": 19},
  {"op": "frames", "value": 3},
  {"op": "gutter_menu_click", "value": "Send 'GET /missing'"},
  {"op": "frames", "value": 2},
  {"op": "wait", "what": "run_done", "timeout": 60},
  {"op": "frames", "value": 2},
  {"op": "assert_run_contains", "value": "nothing at /missing"},
  {"op": "assert_run_contains", "value": "404 in"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_error.png"},
  {"op": "log", "value": "an undefined variable is reported and nothing is sent"},
  {"op": "caret", "line": 22},
  {"op": "frames", "value": 15},
  {"op": "gutter_icon_click", "line": 22},
  {"op": "frames", "value": 3},
  {"op": "gutter_menu_click", "value": "Send 'GET /{{undefined_thing}}'"},
  {"op": "frames", "value": 3},
  {"op": "assert_toast", "value": "undefined_thing"},
  {"op": "assert_run_tabs", "value": ["HTTP Hello", "HTTP Echo", "HTTP GET /moved", "HTTP GET /missing"], "active": "HTTP GET /missing"},
  {"op": "quit"}
]
