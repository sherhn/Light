[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},

  {"op": "log", "value": "three changes in two directories: two tracked, one new file"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "set_text", "value": "(defun alpha (x)\\n  (* x 3))\\n\\n(defun beta (y)\\n  (alpha y))\\n(defun gamma () 1)\\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "open", "path": "${PROJ}/src/messy.lisp"},
  {"op": "set_text", "value": "(defun f (x)\\n  (+ x 1))\\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "key", "value": "Alt+Insert"},
  {"op": "assert_popup", "value": "new_file"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "fresh.lisp"},
  {"op": "key", "value": "Enter"},
  {"op": "frames", "value": 4},
  {"op": "set_text", "value": "(print 1)\\n"},
  {"op": "key", "value": "Ctrl+S"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "assert_git_changes", "value": 3},

  {"op": "log", "value": "the Commit window docks on the left, tracked files are checked, new files are not"},
  {"op": "key", "value": "Alt+0"},
  {"op": "assert_left", "value": "commit"},
  {"op": "frames", "value": 5},
  {"op": "assert_commit_rows", "value": 3},
  {"op": "assert_checked", "value": 2},
  {"op": "assert_checked", "value": 2, "path": "fresh.lisp", "on": false},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_window.png"},

  {"op": "log", "value": "a click on a file shows its diff side by side in the editor area"},
  {"op": "commit_click", "value": "src/nav.lisp"},
  {"op": "frames", "value": 5},
  {"op": "assert_diff", "mode": "unified"},
  {"op": "diff_mode", "value": "side"},
  {"op": "assert_diff", "file": "src/nav.lisp", "hunks": 2, "current": 0, "added": 2, "removed": 1, "mode": "side"},
  {"op": "assert_diff", "old_contains": "(* x 2)", "new_contains": "(* x 3)"},
  {"op": "assert_tabs", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_diff_side.png"},

  {"op": "log", "value": "next and previous difference wrap around"},
  {"op": "command", "value": "diff.next"},
  {"op": "assert_diff", "current": 1},
  {"op": "command", "value": "diff.next"},
  {"op": "assert_diff", "current": 0},
  {"op": "command", "value": "diff.prev"},
  {"op": "assert_diff", "current": 1},
  {"op": "key", "value": "Shift+F7"},
  {"op": "assert_diff", "current": 0},
  {"op": "key", "value": "F7"},
  {"op": "assert_diff", "current": 1},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_diff_second_hunk.png"},

  {"op": "log", "value": "unified view of the same diff"},
  {"op": "diff_mode", "value": "unified"},
  {"op": "frames", "value": 4},
  {"op": "assert_diff", "mode": "unified", "hunks": 2},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_diff_unified.png"},
  {"op": "diff_mode", "value": "side"},

  {"op": "log", "value": "the same tab walks through the changed files"},
  {"op": "command", "value": "diff.next_file"},
  {"op": "assert_diff", "file": "fresh.lisp", "hunks": 1, "added": 1, "removed": 0},
  {"op": "assert_tabs", "value": 4},
  {"op": "command", "value": "diff.next_file"},
  {"op": "assert_diff", "file": "src/messy.lisp"},
  {"op": "command", "value": "diff.prev_file"},
  {"op": "assert_diff", "file": "fresh.lisp"},

  {"op": "log", "value": "checkboxes select what goes into the commit"},
  {"op": "commit_click", "value": "src/nav.lisp", "checkbox": true},
  {"op": "frames", "value": 3},
  {"op": "assert_checked", "value": 1},
  {"op": "commit_click", "value": "src/nav.lisp", "checkbox": true},
  {"op": "frames", "value": 3},
  {"op": "assert_checked", "value": 2},
  {"op": "commit_click", "value": "fresh.lisp", "checkbox": true},
  {"op": "frames", "value": 3},
  {"op": "assert_checked", "value": 3},
  {"op": "commit_click", "value": "fresh.lisp", "checkbox": true},
  {"op": "frames", "value": 3},
  {"op": "assert_checked", "value": 2},

  {"op": "log", "value": "commit from the window with the message box"},
  {"op": "key", "value": "Ctrl+K"},
  {"op": "frames", "value": 3},
  {"op": "text", "value": "two files changed"},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_message.png"},
  {"op": "key", "value": "Ctrl+Enter"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 8},
  {"op": "assert_git_log", "value": "two files changed"},
  {"op": "frames", "value": 6},
  {"op": "assert_git_changes", "value": 1},
  {"op": "assert_commit_rows", "value": 1},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_after_commit.png"},

  {"op": "log", "value": "the diff tab follows a file that is no longer changed"},
  {"op": "commit_click", "value": "fresh.lisp"},
  {"op": "frames", "value": 4},
  {"op": "assert_diff", "file": "fresh.lisp"},
  {"op": "quit"}
]
