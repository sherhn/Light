[
  {"op": "log", "value": "@custom_theme: your own theme - a palette with colours changed by hand, kept when the theme is switched"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "open", "path": "${PROJ}/src/main.lisp"},
  {"op": "wait", "what": "index"},
  {"op": "assert_theme", "value": "dark", "dark": true},

  {"op": "log", "value": "Settings > Appearance > Custom: it starts from the look that is on screen"},
  {"op": "key", "value": "Ctrl+Alt+S"},
  {"op": "assert_popup", "value": "settings"},
  {"op": "click", "x": 968, "y": 280},
  {"op": "frames", "value": 4},
  {"op": "assert_theme", "value": "custom", "dark": true, "colors": {"accent": "#B3D6AD"}},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_custom_start.png"},

  {"op": "log", "value": "type a hex code into the field of a colour: it is taken at once, the sample and the whole window follow"},
  {"op": "wheel", "x": 760, "y": 420, "dy": -700},
  {"op": "frames", "value": 40},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_custom_scrolled.png"},
  {"op": "log", "value": "the swatch opens a colour picker"},
  {"op": "click", "x": 990, "y": 526},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_custom_picker.png"},
  {"op": "click", "x": 320, "y": 600},
  {"op": "frames", "value": 3},
  {"op": "click", "x": 905, "y": 526},
  {"op": "frames", "value": 2},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "#FF5500"},
  {"op": "frames", "value": 3},
  {"op": "assert_theme", "value": "custom", "colors": {"accent": "#FF5500", "text": "#E5E9E7"}},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_custom_typed.png"},

  {"op": "log", "value": "half a code does nothing; a wrong one is dropped when the field is left"},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "#12"},
  {"op": "frames", "value": 2},
  {"op": "assert_theme", "colors": {"accent": "#FF5500"}},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},

  {"op": "log", "value": "the rest by script: a palette with colours changed, on the dark and the light palette"},
  {"op": "theme", "value": "custom", "dark": true, "set": {"comment": "#00FFAA", "hover": "#FFFFFF20", "rainbow2": "#123456"}},
  {"op": "frames", "value": 4},
  {"op": "assert_theme", "value": "custom", "dark": true, "colors": {"accent": "#FF5500", "comment": "#00FFAA", "hover": "#FFFFFF20", "rainbow2": "#123456", "text": "#E5E9E7"}},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_custom_editor.png"},
  {"op": "theme", "value": "custom", "dark": false, "set": {"accent": "#7A1FD6"}},
  {"op": "frames", "value": 4},
  {"op": "assert_theme", "value": "custom", "dark": false, "colors": {"accent": "#7A1FD6", "comment": "#00FFAA", "text": "#26322B"}},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_custom_light.png"},

  {"op": "log", "value": "the dark/light switch leaves the custom theme for the opposite palette; the colours are kept"},
  {"op": "command", "value": "view.toggle_theme"},
  {"op": "frames", "value": 3},
  {"op": "assert_theme", "value": "dark", "dark": true, "colors": {"accent": "#B3D6AD"}},
  {"op": "theme", "value": "custom"},
  {"op": "assert_theme", "value": "custom", "dark": false, "colors": {"accent": "#7A1FD6"}},

  {"op": "log", "value": "give colours back one by one and all together"},
  {"op": "theme", "value": "custom", "reset": ["accent"]},
  {"op": "assert_theme", "value": "custom", "colors": {"accent": "#46674B", "comment": "#00FFAA"}},
  {"op": "theme", "value": "custom", "reset": true},
  {"op": "assert_theme", "value": "custom", "colors": {"comment": "#6C7B6E"}},

  {"op": "log", "value": "Settings > Appearance on the light palette"},
  {"op": "key", "value": "Ctrl+Alt+S"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_settings_light.png"},
  {"op": "wheel", "x": 760, "y": 420, "dy": 3000},
  {"op": "frames", "value": 40},
  {"op": "click", "x": 843, "y": 280},
  {"op": "frames", "value": 3},
  {"op": "assert_theme", "value": "dark", "dark": true},
  {"op": "key", "value": "Escape"},
  {"op": "quit"}
]
