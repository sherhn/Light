[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "frames", "value": 4},
  {"op": "log", "value": "search by mixed-case filename finds a file inside the collapsed src directory"},
  {"op": "click", "x": 150, "y": 160},
  {"op": "text", "value": "NaV"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_search.png"},
  {"op": "click", "x": 155, "y": 200},
  {"op": "frames", "value": 1},
  {"op": "click", "x": 155, "y": 200},
  {"op": "frames", "value": 3},
  {"op": "assert_active_file", "value": "nav.lisp"},
  {"op": "log", "value": "pasted multiline command stays within the terminal; editing keeps its newlines"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "frames", "value": 4},
  {"op": "paste", "value": "echo first\necho second\necho third\necho fourth\necho fifth\necho sixth\necho seventh\necho eighth\necho ninth\necho tenth"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_multiline.png"},
  {"op": "key", "value": "Ctrl+A"},
  {"op": "text", "value": "echo after-multiline"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_idle", "timeout": 20},
  {"op": "assert_term_contains", "value": "after-multiline"},
  {"op": "frames", "value": 4},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_recovered.png"},
  {"op": "quit"}
]
