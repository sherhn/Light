[
  {"op": "log", "value": "@linux_distro @full_window: the developer tools of a distribution can be chosen package by package, and tools of one's own added"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "command", "value": "app.settings"},
  {"op": "settings_page", "value": 3},
  {"op": "frames", "value": 6},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "wheel", "x": 740, "y": 500, "dy": -1500},
  {"op": "frames", "value": 40},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_all_chosen.png"},

  {"op": "log", "value": "everything is chosen to begin with"},
  {"op": "assert_linux_tools", "groups": ["Git and network", "Files and text", "Documentation"], "install_has": ["git", "vim", "doxygen", "jq"], "custom": []},

  {"op": "log", "value": "leave out a group and a single package"},
  {"op": "linux_tool", "value": "skip", "group": "Documentation"},
  {"op": "linux_tool", "value": "skip", "name": "vim"},
  {"op": "linux_tool", "value": "open", "group": "Files and text"},
  {"op": "frames", "value": 4},
  {"op": "assert_linux_tools", "install_has": ["git", "jq", "nano"], "install_lacks": ["doxygen", "man-db", "manpages-dev", "vim"]},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_some_left_out.png"},

  {"op": "log", "value": "a tool of one's own: what is wrong with it is told, and the form stays open"},
  {"op": "linux_tool", "value": "add", "name": "Bad", "packages": "nmap; reboot"},
  {"op": "assert_linux_tools", "draft": true, "draft_error": "letters, digits", "custom": []},
  {"op": "linux_tool", "value": "add", "name": "Documentation", "packages": "nmap"},
  {"op": "assert_linux_tools", "draft": true, "draft_error": "already exists", "custom": []},
  {"op": "wheel", "x": 740, "y": 500, "dy": -3000},
  {"op": "frames", "value": 40},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_form.png"},
  {"op": "linux_tool", "value": "add", "name": "", "packages": "nmap"},
  {"op": "assert_linux_tools", "draft": true, "draft_error": "name", "custom": []},
  {"op": "wheel", "x": 740, "y": 500, "dy": 1000},
  {"op": "frames", "value": 40},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_groups.png"},
  {"op": "wheel", "x": 740, "y": 500, "dy": -420},
  {"op": "frames", "value": 40},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_groups_list.png"},
  {"op": "log", "value": "the mouse: the box of a group takes all its packages (or none), a package is a chip of its own"},
  {"op": "click", "x": 470, "y": 519},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_has": ["man-db", "doxygen"]},
  {"op": "click", "x": 470, "y": 519},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_lacks": ["man-db", "doxygen"]},
  {"op": "click", "x": 963, "y": 424},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_has": ["vim"]},
  {"op": "click", "x": 963, "y": 424},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_lacks": ["vim"], "install_has": ["nano"]},
  {"op": "log", "value": "a box that is half ticked takes all, then none, then all again"},
  {"op": "click", "x": 470, "y": 371},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_has": ["vim", "nano", "jq", "zip"]},
  {"op": "click", "x": 470, "y": 371},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_lacks": ["vim", "nano", "jq", "zip"], "install_has": ["git"]},
  {"op": "click", "x": 470, "y": 371},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_has": ["vim", "nano", "jq", "zip"]},
  {"op": "click", "x": 963, "y": 424},
  {"op": "frames", "value": 3},
  {"op": "assert_linux_tools", "install_lacks": ["vim", "doxygen"], "install_has": ["nano"]},
  {"op": "linux_tool", "value": "add", "name": "Libraries", "packages": "libssl-dev  zlib1g-dev"},
  {"op": "assert_linux_tools", "draft": false, "custom": ["Libraries"], "groups": ["Libraries"], "install_has": ["libssl-dev", "zlib1g-dev"]},
  {"op": "linux_tool", "value": "add", "name": "Network", "packages": "tcpdump", "programs": "tcpdump"},
  {"op": "assert_linux_tools", "custom": ["Libraries", "Network"]},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "frames", "value": 6},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "wheel", "x": 740, "y": 500, "dy": -3000},
  {"op": "frames", "value": 40},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_own_tools.png"},

  {"op": "log", "value": "install what is chosen: nothing that was left out is asked of the package manager"},
  {"op": "wsl_action", "value": "install_tools", "arg": "Ubuntu-24.04"},
  {"op": "wait", "what": "wsl_idle", "timeout": 60},
  {"op": "frames", "value": 3},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "assert_wsl", "outcome_contains": "developer tools are installed", "log_contains": "libssl-dev", "log_lacks": "doxygen"},
  {"op": "assert_wsl", "log_lacks": "vim", "tools_found": {"git": true, "jq": true, "vim": false, "doxygen": false, "dpkg:libssl-dev": true, "dpkg:zlib1g-dev": true, "tcpdump": true}},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_installed.png"},

  {"op": "log", "value": "change your mind: take the package back and remove a tool of one's own"},
  {"op": "linux_tool", "value": "choose", "name": "vim"},
  {"op": "linux_tool", "value": "remove", "name": "Libraries"},
  {"op": "assert_linux_tools", "custom": ["Network"], "install_has": ["vim", "tcpdump"], "install_lacks": ["libssl-dev", "doxygen"]},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "key", "value": "Escape"},
  {"op": "quit"}
]
