[
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},

  {"op": "log", "value": "the Linux (WSL) page finds no WSL on this (fake) machine"},
  {"op": "command", "value": "app.settings"},
  {"op": "assert_popup", "value": "settings"},
  {"op": "settings_page", "value": 3},
  {"op": "frames", "value": 4},
  {"op": "wait", "what": "wsl_idle", "timeout": 30},
  {"op": "frames", "value": 4},
  {"op": "assert_wsl", "presence": "not_installed", "distros": 0, "run_env": "windows"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_1_no_wsl.png"},

  {"op": "log", "value": "step 1: install WSL"},
  {"op": "wsl_action", "value": "install_wsl"},
  {"op": "wait", "what": "wsl_idle", "timeout": 60},
  {"op": "frames", "value": 4},
  {"op": "assert_wsl", "presence": "installed", "distros": 0, "outcome_contains": "WSL"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_2_wsl_ready.png"},

  {"op": "log", "value": "an .iso is refused with an explanation, nothing is started"},
  {"op": "wsl_action", "value": "install_file", "arg": "C:/nowhere/ubuntu-24.04.3-desktop-amd64.iso"},
  {"op": "frames", "value": 3},
  {"op": "assert_wsl", "distros": 0, "outcome_contains": "ISO"},

  {"op": "log", "value": "step 2: install Ubuntu 24.04 with a progress bar"},
  {"op": "wsl_action", "value": "install_distro", "arg": "Ubuntu-24.04"},
  {"op": "frames", "value": 12},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_3_installing.png"},
  {"op": "wait", "what": "wsl_idle", "timeout": 60},
  {"op": "frames", "value": 4},
  {"op": "assert_wsl", "distros": 1, "selected": "Ubuntu-24.04", "sbcl": "missing", "outcome_contains": "Ubuntu-24.04"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_4_distro_ready.png"},

  {"op": "log", "value": "Linux works before installing SBCL, even with the Lisp module enabled"},
  {"op": "wsl_action", "value": "use", "arg": "Ubuntu-24.04"},
  {"op": "assert_wsl", "run_env": "wsl", "sbcl": "missing"},
  {"op": "wsl_action", "value": "use_windows"},
  {"op": "assert_wsl", "run_env": "windows"},

  {"op": "log", "value": "optional Lisp tools: install SBCL inside it"},
  {"op": "wsl_action", "value": "install_sbcl", "arg": "Ubuntu-24.04"},
  {"op": "wait", "what": "wsl_progress", "value": 0.5, "timeout": 30},
  {"op": "assert_wsl_progress", "stage": "Install", "min": 0.5, "max": 0.97},
  {"op": "frames", "value": 3},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_4b_installing_sbcl.png"},
  {"op": "wait", "what": "wsl_idle", "timeout": 60},
  {"op": "frames", "value": 4},
  {"op": "assert_wsl", "sbcl": "found", "outcome_contains": "SBCL"},

  {"op": "log", "value": "run development tools in Linux"},
  {"op": "wsl_action", "value": "use", "arg": "Ubuntu-24.04"},
  {"op": "frames", "value": 4},
  {"op": "assert_wsl", "run_env": "wsl"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_5_in_use.png"},
  {"op": "key", "value": "Escape"},
  {"op": "assert_popup", "value": "none"},

  {"op": "log", "value": "the REPL starts through WSL (paths go to /mnt/c and back)"},
  {"op": "command", "value": "view.repl"},
  {"op": "wait", "what": "repl_ready", "timeout": 90},
  {"op": "command", "value": "repl.focus"},
  {"op": "text", "value": "(+ 40 2)"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "repl_contains", "value": "42", "timeout": 30},
  {"op": "assert_repl_contains", "value": "42"},

  {"op": "log", "value": "Run a file through WSL"},
  {"op": "open", "path": "${PROJ}/src/hello.lisp"},
  {"op": "command", "value": "run.run_file"},
  {"op": "wait", "what": "run_done", "timeout": 90},
  {"op": "assert_run_contains", "value": "Hi from run"},

  {"op": "log", "value": "the line terminal (Commands) runs in the distribution and shows a Linux prompt"},
  {"op": "terminal_mode", "value": "commands"},
  {"op": "key", "value": "Alt+F12"},
  {"op": "frames", "value": 4},
  {"op": "text", "value": "echo hello-from-linux"},
  {"op": "key", "value": "Enter"},
  {"op": "wait", "what": "term_contains", "value": "hello-from-linux", "timeout": 30},
  {"op": "wait", "what": "term_idle", "timeout": 30},
  {"op": "assert_term_contains", "value": "Ubuntu-24.04:/mnt/"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_6_terminal.png"},

  {"op": "log", "value": "back to Windows"},
  {"op": "wsl_action", "value": "use_windows"},
  {"op": "assert_wsl", "run_env": "windows"},
  {"op": "quit"}
]
