[
  {"op": "log", "value": "@untracked_files: a file that .gitignore names has no change markers and no diff, whatever the base says; a new file it does not name is all new"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "wait", "what": "git_ready", "timeout": 30},

  {"op": "log", "value": "a new file of the project: every line is new"},
  {"op": "open", "path": "${PROJ}/src/fresh.lisp"},
  {"op": "frames", "value": 6},
  {"op": "assert_marks", "min": 1},

  {"op": "log", "value": "the files .gitignore names (`*.fasl`, `/build/`): no markers at all"},
  {"op": "open", "path": "${PROJ}/src/generated.fasl"},
  {"op": "frames", "value": 6},
  {"op": "assert_marks", "exact": 0},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_fasl.png"},
  {"op": "open", "path": "${PROJ}/build/output.bin"},
  {"op": "frames", "value": 6},
  {"op": "assert_marks", "exact": 0},
  {"op": "set_text", "value": "edited generated output\n"},
  {"op": "frames", "value": 4},
  {"op": "assert_marks", "exact": 0},

  {"op": "log", "value": "no diff for them either"},
  {"op": "diff_open", "value": "src/generated.fasl"},
  {"op": "assert_toast", "value": "ignored by Git"},
  {"op": "assert_tabs", "value": 3},
  {"op": "diff_open", "value": "src/fresh.lisp"},
  {"op": "assert_tabs", "value": 4},
  {"op": "assert_diff", "file": "src/fresh.lisp"},

  {"op": "log", "value": "a tracked file shows its changes as ever"},
  {"op": "open", "path": "${PROJ}/src/nav.lisp"},
  {"op": "set_text", "value": "(defun alpha (x)\n  (* x 5))\n"},
  {"op": "frames", "value": 6},
  {"op": "assert_marks", "min": 1},

  {"op": "log", "value": "the rules change while the files are open: the markers follow"},
  {"op": "open", "path": "${PROJ}/src/generated.fasl"},
  {"op": "assert_marks", "exact": 0},
  {"op": "disk_write", "path": "${PROJ}/.gitignore", "value": "/build/\n"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_dirty", "timeout": 30},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 12},
  {"op": "assert_marks", "min": 1},
  {"op": "open", "path": "${PROJ}/src/fresh.lisp"},
  {"op": "assert_marks", "min": 1},
  {"op": "disk_write", "path": "${PROJ}/.gitignore", "value": "/build/\nsrc/fresh.lisp\n"},
  {"op": "command", "value": "git.refresh"},
  {"op": "wait", "what": "git_settled", "timeout": 30},
  {"op": "frames", "value": 30},
  {"op": "assert_marks", "exact": 0},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_fresh_ignored.png"},

  {"op": "quit"}
]
