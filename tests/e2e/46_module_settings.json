[
  {"op":"log","value":"@no_modules @polyglot: Lisp settings follow the enabled module"},
  {"op":"command","value":"app.modules"},
  {"op":"wait","what":"modules_index","timeout":30},
  {"op":"wait","what":"modules_idle","timeout":30},
  {"op":"command","value":"app.settings"},
  {"op":"settings_page","value":2},
  {"op":"frames","value":6},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_without_lisp.png"},
  {"op":"key","value":"Escape"},
  {"op":"module_install","value":"lisp"},
  {"op":"wait","what":"modules_idle","timeout":30},
  {"op":"assert_modules","installed":["lisp"],"enabled":["lisp"]},
  {"op":"command","value":"app.settings"},
  {"op":"settings_page","value":2},
  {"op":"frames","value":6},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_with_lisp.png"},
  {"op":"module_enable","value":"lisp","on":false},
  {"op":"frames","value":6},
  {"op":"assert_modules","installed":["lisp"],"enabled":[]},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_disabled.png"},
  {"op":"module_enable","value":"lisp","on":true},
  {"op":"frames","value":6},
  {"op":"settings_page","value":2},
  {"op":"frames","value":6},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_reenabled.png"},
  {"op":"module_remove","value":"lisp"},
  {"op":"wait","what":"modules_idle","timeout":30},
  {"op":"frames","value":6},
  {"op":"assert_modules","installed":[],"enabled":[]},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_removed.png"},
  {"op":"quit"}
]
