[
  {"op": "log", "value": "@markup @full_window @modules markdown,restructuredtext,python,c-cpp: a Markdown tab is code and preview side by side, scrolled together, and has three modes"},
  {"op": "open_project", "path": "${PROJ}"},
  {"op": "wait", "what": "index"},
  {"op": "open", "path": "${PROJ}/site/guide.md"},
  {"op": "assert_language", "value": "markdown"},
  {"op": "frames", "value": 8},
  {"op": "assert_preview", "mode": "split", "blocks_min": 10, "scrolled": false},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_split.png"},

  {"op": "log", "value": "scrolling the code scrolls the preview"},
  {"op": "caret", "line": 60, "col": 1},
  {"op": "frames", "value": 40},
  {"op": "assert_preview", "scrolled": true, "in_sync": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_followed.png"},

  {"op": "log", "value": "scrolling the preview scrolls the code"},
  {"op": "wheel", "x": 960, "y": 400, "dy": 2000},
  {"op": "frames", "value": 12},
  {"op": "assert_preview", "scrolled": false, "in_sync": true},

  {"op": "log", "value": "preview only: nothing receives typing"},
  {"op": "command", "value": "view.preview_only"},
  {"op": "frames", "value": 8},
  {"op": "assert_preview", "mode": "preview", "blocks_min": 10},
  {"op": "text", "value": "typed into the void"},
  {"op": "frames", "value": 2},
  {"op": "assert_modified", "value": false},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_preview.png"},
  {"op": "wheel", "x": 700, "y": 400, "dy": -750},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_preview_code.png"},
  {"op": "wheel", "x": 700, "y": 400, "dy": -650},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_preview_more.png"},

  {"op": "log", "value": "back to the code"},
  {"op": "command", "value": "view.preview_code"},
  {"op": "frames", "value": 4},
  {"op": "assert_preview", "mode": "code"},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_code.png"},

  {"op": "log", "value": "reStructuredText has the same three modes; the choice is the new default"},
  {"op": "open", "path": "${PROJ}/site/manual.rst"},
  {"op": "assert_language", "value": "rst"},
  {"op": "frames", "value": 8},
  {"op": "assert_preview", "mode": "code"},
  {"op": "command", "value": "view.preview_split"},
  {"op": "frames", "value": 8},
  {"op": "assert_preview", "mode": "split", "blocks_min": 5},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_rst.png"},
  {"op": "command", "value": "view.preview_only"},
  {"op": "wheel", "x": 700, "y": 400, "dy": -600},
  {"op": "frames", "value": 6},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_rst_more.png"},
  {"op": "command", "value": "view.preview_split"},

  {"op": "log", "value": "links in the preview: to a section, then to another file"},
  {"op": "open", "path": "${PROJ}/site/guide.md"},
  {"op": "command", "value": "view.preview_only"},
  {"op": "frames", "value": 8},
  {"op": "wheel", "x": 700, "y": 400, "dy": 6000},
  {"op": "frames", "value": 40},
  {"op": "assert_preview", "mode": "preview", "scrolled": false},
  {"op": "click", "x": 1069, "y": 366},
  {"op": "frames", "value": 10},
  {"op": "assert_preview", "scrolled": true},
  {"op": "screenshot", "path": "${SHOTS}/${NAME}_anchor.png"},
  {"op": "wheel", "x": 700, "y": 400, "dy": 3000},
  {"op": "frames", "value": 40},
  {"op": "click", "x": 930, "y": 366},
  {"op": "frames", "value": 8},
  {"op": "assert_active_file", "value": "manual.rst"},
  {"op": "command", "value": "view.preview_split"},

  {"op": "log", "value": "other files have no preview"},
  {"op": "open", "path": "${PROJ}/src/main.lisp"},
  {"op": "assert_preview", "mode": "none"},
  {"op": "command", "value": "view.preview_only"},
  {"op": "assert_toast", "value": "Only Markdown and reStructuredText"},
  {"op": "quit"}
]
