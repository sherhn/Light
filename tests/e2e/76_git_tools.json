[
  {"op":"log","value":"@merge_conflict blame, the history of a file, stashes, comparing branches, revert and the interactive rebase"},
  {"op":"open_project","path":"${PROJ}"},
  {"op":"wait","what":"index"},
  {"op":"wait","what":"git_ready","timeout":30},
  {"op":"open","path":"${PROJ}/notes/parts.txt"},
  {"op":"frames","value":3},

  {"op":"log","value":"blame: when and who next to every line; an edit saved is not committed"},
  {"op":"command","value":"git.blame"},
  {"op":"frames","value":3},
  {"op":"assert_blame","line":2,"value":"E2E"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_blame.png"},
  {"op":"caret","line":2,"col":1},
  {"op":"text","value":"// "},
  {"op":"command","value":"file.save"},
  {"op":"frames","value":3},
  {"op":"command","value":"git.refresh"},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"frames","value":3},
  {"op":"assert_blame","line":2,"value":"Not committed"},
  {"op":"assert_blame","line":1,"value":"E2E"},

  {"op":"log","value":"stash puts the edit aside and pop brings it back"},
  {"op":"command","value":"git.stash"},
  {"op":"frames","value":2},
  {"op":"assert_popup","value":"stash"},
  {"op":"stash_set","message":"half done"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_stash_dialog.png"},
  {"op":"key","value":"Enter"},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"assert_bottom","value":"git"},
  {"op":"assert_stashes","count":1},
  {"op":"assert_file_contains","path":"${PROJ}/notes/parts.txt","value":"\nfirst = main"},
  {"op":"assert_text","value":"alpha\nfirst = main\nm1\nm2\nm3\nm4\nm5\nm6\nsecond = main\nomega\n"},
  {"op":"frames","value":3},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_stashes.png"},
  {"op":"git_click","value":"stash:pop:On main: half done"},
  {"op":"frames","value":3},
  {"op":"assert_stashes","count":0},
  {"op":"assert_file_contains","path":"${PROJ}/notes/parts.txt","value":"// first = main"},
  {"op":"command","value":"git.rollback"},
  {"op":"frames","value":2},
  {"op":"confirm_accept"},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},

  {"op":"log","value":"the history of the file: a click shows what a commit changed in it"},
  {"op":"command","value":"git.file_history"},
  {"op":"frames","value":3},
  {"op":"git_click","value":"history:main work"},
  {"op":"frames","value":3},
  {"op":"assert_diff","value":"first = main"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_history.png"},

  {"op":"log","value":"compare with feature: its commit, ours, and the files that differ side by side"},
  {"op":"command","value":"git.compare"},
  {"op":"frames","value":2},
  {"op":"text","value":"feature"},
  {"op":"key","value":"Enter"},
  {"op":"frames","value":3},
  {"op":"git_click","value":"compare:feature work"},
  {"op":"git_click","value":"file:notes/whole.txt"},
  {"op":"frames","value":3},
  {"op":"assert_diff","value":"feature line"},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_compare.png"},

  {"op":"log","value":"revert a commit, then an interactive rebase rewords one commit and drops the revert"},
  {"op":"git_revert","value":"main work"},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"assert_git_log","value":"Revert \"main work\""},
  {"op":"assert_file_contains","path":"${PROJ}/notes/whole.txt","value":"base line"},
  {"op":"git_open_rebase","value":"notes"},
  {"op":"frames","value":3},
  {"op":"assert_popup","value":"rebase"},
  {"op":"git_click","value":"0:reword"},
  {"op":"frames","value":2},
  {"op":"rebase_set","row":0,"message":"main work, reworded"},
  {"op":"git_click","value":"1:drop"},
  {"op":"frames","value":3},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_rebase.png"},
  {"op":"git_click","value":"start"},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"frames","value":3},
  {"op":"wait","what":"git_settled","timeout":30},
  {"op":"assert_popup","value":"none"},
  {"op":"assert_git_log","value":"main work, reworded"},
  {"op":"assert_file_contains","path":"${PROJ}/notes/whole.txt","value":"main line"},

  {"op":"log","value":"a right click on a commit of the log opens its menu"},
  {"op":"git_click","value":"log"},
  {"op":"frames","value":3},
  {"op":"git_click","value":"log:main work, reworded","right":true},
  {"op":"frames","value":3},
  {"op":"screenshot","path":"${SHOTS}/${NAME}_menu.png"},
  {"op":"quit"}
]
