      ],
      "brackets": [
        "()",
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "braces",
        "size": 2
      },
      "fold": "braces",
      "grammar": [
        {
          "match": "//[^\\n]*",
          "class": "comment"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "class": "comment"
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "match": "'(?:[^'\\\\\\n]|\\\\.)*'?",
          "class": "string"
        },
        {
          "begin": "`",
          "end": "(?:\\\\.|[^`\\\\])*`",
          "class": "string"
        },
        {
          "match": "(?:^|[=(,:;!&|?{}])[ \\t]*(/(?:\\\\.|\\[(?:\\\\.|[^\\]\\\\\\n])*\\]|[^/\\\\\\n])+/[dgimsuvy]*)",
          "captures": {
            "1": "string"
          }
        },
        {
          "match": "\\b(class)[ \\t]+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": "keyword",
            "2": "type"
          }
        },
        {
          "match": "\\b(function)[ \\t]*\\*?[ \\t]+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": "keyword",
            "2": "function"
          }
        },
        {
          "words": [
            "async",
            "await",
            "break",
            "case",
            "catch",
            "class",
            "const",
            "continue",
            "debugger",
            "default",
