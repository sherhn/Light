            "typeof",
            "var",
            "void",
            "while",
            "with",
            "yield",
            "as"
          ],
          "class": "keyword"
        },
        {
          "words": [
            "Array",
            "ArrayBuffer",
            "BigInt",
            "Boolean",
            "Date",
            "Error",
            "EvalError",
            "Function",
            "Intl",
            "JSON",
            "Map",
            "Math",
            "Number",
