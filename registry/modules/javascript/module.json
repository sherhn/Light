{
  "version": "1.0.2",
  "cover": "cover.png",
  "license": "MIT",
  "author": "Light contributors",
  "id": "javascript",
  "name": "JavaScript",
  "category": "Languages",
  "summary": "JavaScript/JSX, Node.js and npm: highlighting, completion, outline, folding, syntax checks, run, watch and tests.",
  "description": "JavaScript ES modules and CommonJS, JSX and package.json. Syntax coloring includes comments, strings, template literals, regular expressions, keywords and browser/Node builtins. Brace indentation and folding, function/class outline and completion. Node.js syntax checks, Run, Watch and node:test; package.json exposes npm install, start, dev, build, test and lint. Uses your Node.js/npm on Windows, macOS or Linux (including WSL). No files or dependencies are created until you explicitly run a command.",
  "languages": [
    {
      "id": "javascript",
      "name": "JavaScript",
      "extensions": [
        "js",
        "mjs",
        "cjs"
      ],
      "first_line": "^#!.*\\bnode",
      "line_comment": "//",
      "block_comment": [
        "/*",
        "*/"
      ],
      "brackets": [
        "()",
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "braces",
        "size": 2
      },
      "fold": "braces",
      "check": [
        "brackets"
      ],
      "grammar": [
        {
          "match": "//[^\\n]*",
          "class": "comment"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "class": "comment"
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "match": "'(?:[^'\\\\\\n]|\\\\.)*'?",
          "class": "string"
        },
        {
          "begin": "`",
          "end": "(?:\\\\.|[^`\\\\])*`",
          "class": "string"
        },
        {
          "match": "(?:^|[=(,:;!&|?{}])[ \\t]*(/(?:\\\\.|\\[(?:\\\\.|[^\\]\\\\\\n])*\\]|[^/\\\\\\n])+/[dgimsuvy]*)",
          "captures": {
            "1": "string"
          }
        },
        {
          "match": "\\b(class)[ \\t]+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": "keyword",
            "2": "type"
          }
        },
        {
          "match": "\\b(function)[ \\t]*\\*?[ \\t]+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": "keyword",
            "2": "function"
          }
        },
        {
          "words": [
            "async",
            "await",
            "break",
            "case",
            "catch",
            "class",
            "const",
            "continue",
            "debugger",
            "default",
            "delete",
            "do",
            "else",
            "export",
            "extends",
            "finally",
            "for",
            "from",
            "function",
            "get",
            "if",
            "import",
            "in",
            "instanceof",
            "let",
            "new",
            "of",
            "return",
            "set",
            "static",
            "super",
            "switch",
            "throw",
            "try",
            "typeof",
            "var",
            "void",
            "while",
            "with",
            "yield",
            "as"
          ],
          "class": "keyword"
        },
        {
          "words": [
            "Array",
            "ArrayBuffer",
            "BigInt",
            "Boolean",
            "Date",
            "Error",
            "EvalError",
            "Function",
            "Intl",
            "JSON",
            "Map",
            "Math",
            "Number",
            "Object",
            "Promise",
            "Proxy",
            "RangeError",
            "Reflect",
            "RegExp",
            "Set",
            "String",
            "Symbol",
            "SyntaxError",
            "TypeError",
            "URIError",
            "Uint8Array",
            "URL",
            "URLSearchParams",
            "WeakMap",
            "WeakSet",
            "WebSocket",
            "console",
            "document",
            "window",
            "globalThis",
            "process",
            "Buffer",
            "require",
            "module",
            "exports",
            "fetch",
            "setTimeout",
            "clearTimeout",
            "setInterval",
            "clearInterval",
            "queueMicrotask",
            "structuredClone",
            "parseInt",
            "parseFloat",
            "isNaN",
            "isFinite",
            "encodeURIComponent",
            "decodeURIComponent",
            "AbortController",
            "TextEncoder",
            "TextDecoder"
          ],
          "class": "builtin"
        },
        {
          "words": [
            "true",
            "false",
            "null",
            "undefined",
            "NaN",
            "Infinity"
          ],
          "class": "constant"
        },
        {
          "match": "\\b(?:0[xX][\\da-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?[\\d_]+)?n?)\\b",
          "class": "number"
        },
        {
          "match": "\\b(this)\\b",
          "class": "variable"
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\(",
          "captures": {
            "1": "function"
          },
          "consume": 1
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*(?:export[ \\t]+(?:default[ \\t]+)?)?(?:async[ \\t]+)?function[ \\t]*\\*?[ \\t]+([\\w$]+)",
          "kind": "function",
          "name": 1
        },
        {
          "pattern": "^[ \\t]*(?:export[ \\t]+(?:default[ \\t]+)?)?class[ \\t]+([\\w$]+)",
          "kind": "class",
          "name": 1
        },
        {
          "pattern": "^[ \\t]*(?:export[ \\t]+)?(?:const|let|var)[ \\t]+([\\w$]+)[ \\t]*=[ \\t]*(?:async[ \\t]+)?(?:\\([^\\n]*\\)|[\\w$]+)[ \\t]*=>",
          "kind": "function",
          "name": 1
        }
      ]
    },
    {
      "id": "jsx",
      "name": "JSX",
      "extensions": [
        "jsx"
      ],
      "line_comment": "//",
      "block_comment": [
