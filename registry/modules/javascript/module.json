          ],
          "class": "constant"
        },
        {
          "match": "\\b(?:0[xX][\\da-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?[\\d_]+)?n?)\\b",
          "class": "number"
        },
        {
          "match": "\\b(this)\\b",
          "class": "variable"
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\(",
          "captures": {
            "1": "function"
          },
          "consume": 1
        },
        {
          "match": "</?([A-Za-z][\\w.-]*)",
          "captures": {
            "1": "type"
          }
        },
        {
          "match": "\\b([\\w-]+)=",
          "captures": {
            "1": "argument"
          }
        }
      ],
      "outline": [
        {
          "pattern": "(?:function|class)[ \\t]+([\\w$]+)",
          "kind": "function",
          "name": 1
        }
      ]
    },
    {
      "id": "javascript-package",
      "name": "npm package",
      "filenames": [
        "package.json"
      ],
      "brackets": [
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "braces",
        "size": 2
      },
      "fold": "braces",
      "check": [
        "brackets"
      ],
      "grammar": [
        {
          "match": "(\"(?:[^\"\\\\\\n]|\\\\.)*\")[ \\t]*:",
          "captures": {
            "1": "argument"
          }
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "words": [
            "true",
            "false",
            "null"
          ],
          "class": "constant"
        },
        {
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
          "class": "number"
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*\"([^\"\\n]+)\"[ \\t]*:",
          "kind": "variable",
          "name": 1
        }
      ]
    }
  ],
  "run": [
    {
      "language": "javascript",
      "name": "Node: Run file",
      "command": "node \"{file}\""
    },
    {
      "language": "javascript",
      "name": "Node: Watch file",
      "command": "node --watch \"{file}\""
    },
    {
      "language": "javascript",
      "name": "Node: Test file",
      "command": "node --test \"{file}\""
    },
    {
      "language": "javascript",
      "name": "Node: Profile file",
      "profile": "cpuprofile",
      "command": "node --cpu-prof --cpu-prof-dir=\"{report_dir}\" \"{file}\""
    },
    {
      "language": "javascript-package",
      "name": "npm: Install dependencies",
      "command": "npm --prefix \"{dir}\" install"
    },
    {
      "language": "javascript-package",
      "name": "npm: Start",
      "command": "npm --prefix \"{dir}\" start"
    },
    {
      "language": "javascript-package",
      "name": "npm: Development server",
      "command": "npm --prefix \"{dir}\" run dev"
    },
    {
      "language": "javascript-package",
      "name": "npm: Build",
      "command": "npm --prefix \"{dir}\" run build"
    },
    {
      "language": "javascript-package",
      "name": "npm: Test",
      "command": "npm --prefix \"{dir}\" test"
    },
    {
      "language": "javascript-package",
      "name": "npm: Lint",
      "command": "npm --prefix \"{dir}\" run lint"
    }
  ],
  "check": [
    {
      "language": "javascript",
      "name": "Node syntax",
      "command": "node --check \"{file}\"",
      "pattern": "(?m)^(?P<file>[^\\n]+):(?P<line>\\d+)\\r?\\n(?:[^\\n]*\\n)*?SyntaxError: (?P<msg>[^\\n]+)"
    }
  ],
  "tests": [
    {
      "name": "Vitest",
      "languages": [
        "javascript",
        "jsx"
      ],
      "files": "(?:^|/)__tests__/|\\.(?:test|spec)\\.[cm]?jsx?$",
      "project_file": "package.json",
      "project_needs": "\"vitest\"",
      "test": "^\\s*(?:it|test)(?:\\.(?:only|skip|todo|concurrent|fails|failing))*\\(\\s*(?:'(?P<name>[^'\\n]*)'|\"(?P<name2>[^\"\\n]*)\"|`(?P<name3>[^`$\\n]*)`)",
      "suite": "^\\s*(?:describe|suite)(?:\\.(?:only|skip|todo|concurrent|fails|failing))*\\(\\s*(?:'(?P<name>[^'\\n]*)'|\"(?P<name2>[^\"\\n]*)\"|`(?P<name3>[^`$\\n]*)`)",
      "separator": " ",
      "command": "npx vitest run \"{file}\" -t \"{test}\"",
      "file_command": "npx vitest run \"{file}\"",
      "env": {
        "NO_COLOR": "1",
        "FORCE_COLOR": "0"
      },
      "passed": "(?m)^\\s*✓ (?P<name>.+?)(?: \\d+ms)?$",
      "failed": "(?m)^\\s*× (?P<name>.+?)(?: \\d+ms)?$",
      "result_separator": " > "
    },
    {
      "name": "Jest",
      "languages": [
        "javascript",
        "jsx"
      ],
      "files": "(?:^|/)__tests__/|\\.(?:test|spec)\\.[cm]?jsx?$",
      "project_file": "package.json",
      "project_needs": "\"jest\"",
      "test": "^\\s*(?:it|test)(?:\\.(?:only|skip|todo|concurrent|fails|failing))*\\(\\s*(?:'(?P<name>[^'\\n]*)'|\"(?P<name2>[^\"\\n]*)\"|`(?P<name3>[^`$\\n]*)`)",
      "suite": "^\\s*describe(?:\\.(?:only|skip|todo|concurrent|fails|failing))*\\(\\s*(?:'(?P<name>[^'\\n]*)'|\"(?P<name2>[^\"\\n]*)\"|`(?P<name3>[^`$\\n]*)`)",
      "separator": " ",
      "command": "npx jest --runTestsByPath \"{file}\" -t \"{test}\"",
      "file_command": "npx jest --runTestsByPath \"{file}\"",
      "env": {
        "NO_COLOR": "1",
        "FORCE_COLOR": "0"
      },
      "failed": "(?m)^\\s*● (?P<name>.+?)$",
      "result_separator": " › ",
      "coverage": "lcov",
      "coverage_command": "npx jest --runTestsByPath \"{file}\" -t \"{test}\" --coverage --coverageReporters=lcov --coverageReporters=text-summary --coverageDirectory=\"{report_dir}\"",
      "coverage_file_command": "npx jest --runTestsByPath \"{file}\" --coverage --coverageReporters=lcov --coverageReporters=text-summary --coverageDirectory=\"{report_dir}\""
    },
    {
      "name": "node:test",
      "languages": [
        "javascript"
      ],
      "content": "from\\s+['\"]node:test['\"]|require\\(\\s*['\"]node:test['\"]\\s*\\)",
      "project_file": "package.json",
      "test": "^\\s*(?:it|test)(?:\\.(?:only|skip|todo|concurrent|fails|failing))*\\(\\s*(?:'(?P<name>[^'\\n]*)'|\"(?P<name2>[^\"\\n]*)\"|`(?P<name3>[^`$\\n]*)`)",
      "suite": "^\\s*(?:describe|suite)(?:\\.(?:only|skip|todo|concurrent|fails|failing))*\\(\\s*(?:'(?P<name>[^'\\n]*)'|\"(?P<name2>[^\"\\n]*)\"|`(?P<name3>[^`$\\n]*)`)",
      "separator": " ",
      "command": "node --test --test-reporter=tap --test-name-pattern=\"{test}\" \"{file}\"",
      "file_command": "node --test --test-reporter=tap \"{file}\"",
      "passed": "(?m)^\\s*ok \\d+ - (?P<name>.+?)(?: # .*)?$",
      "failed": "(?m)^\\s*not ok \\d+ - (?P<name>.+?)(?: # .*)?$",
      "coverage": "lcov",
      "coverage_command": "node --test --experimental-test-coverage --test-reporter=tap --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=\"{report}\" --test-name-pattern=\"{test}\" \"{file}\"",
      "coverage_file_command": "node --test --experimental-test-coverage --test-reporter=tap --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=\"{report}\" \"{file}\""
    }
  ],
  "debug": [
    {
      "name": "Node.js",
      "languages": [
        "javascript",
        "jsx"
      ],
      "download": {
        "name": "vscode-js-debug",
        "version": "1.140.0",
        "url": "https://github.com/microsoft/vscode-js-debug/releases/download/v1.140.0/js-debug-dap-v1.140.0.tar.gz",
        "sha256": "27dab92937ec1ab35821ae955aac867544fe06a1b6307229049f2d789af10968",
        "size": 1249709,
        "license": "MIT",
        "homepage": "https://github.com/microsoft/vscode-js-debug"
      },
      "adapter_id": "pwa-node",
      "command": [
        "node",
        "{adapter}/js-debug/src/dapDebugServer.js",
        "{port}",
        "127.0.0.1"
      ],
      "launch": {
        "type": "pwa-node",
        "request": "launch",
        "name": "Light",
        "program": "{file}",
        "cwd": "{dir}",
        "console": "internalConsole",
        "skipFiles": [
          "<node_internals>/**"
        ]
      }
    }
  ],
  "tasks": [
    {
      "name": "npm",
      "files": [
        "package.json"
      ],
      "json": "scripts",
      "command": "npm run \"{task}\"",
      "skip": [
        "node_modules"
      ]
    }
  ],
  "tools": [
    {
      "name": "Node.js and npm",
      "programs": [
        "node",
        "npm"
      ],
      "required": [
        "node",
        "npm"
      ],
      "apt": "nodejs npm"
    }
  ],
  "detect": {
    "extensions": [
      "js",
      "mjs",
      "cjs",
      "jsx"
    ],
    "files": [
      "package.json",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml"
    ]
  }
}
