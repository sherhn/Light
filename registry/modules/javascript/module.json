            "WebSocket",
            "console",
            "document",
            "window",
            "globalThis",
            "process",
            "Buffer",
            "require",
            "module",
            "exports",
            "fetch",
            "setTimeout",
            "clearTimeout",
            "setInterval",
            "clearInterval",
            "queueMicrotask",
            "structuredClone",
            "parseInt",
            "parseFloat",
            "isNaN",
            "isFinite",
            "encodeURIComponent",
            "decodeURIComponent",
            "AbortController",
            "TextEncoder",
            "TextDecoder"
          ],
          "class": "builtin"
        },
        {
          "words": [
            "true",
            "false",
            "null",
            "undefined",
            "NaN",
            "Infinity"
          ],
          "class": "constant"
        },
        {
          "match": "\\b(?:0[xX][\\da-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?[\\d_]+)?n?)\\b",
          "class": "number"
        },
        {
          "match": "\\b(this)\\b",
          "class": "variable"
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\(",
          "captures": {
            "1": "function"
          },
          "consume": 1
        },
        {
          "match": "</?([A-Za-z][\\w.-]*)",
          "captures": {
            "1": "type"
          }
        },
        {
          "match": "\\b([\\w-]+)=",
          "captures": {
            "1": "argument"
          }
        }
      ],
      "outline": [
        {
          "pattern": "(?:function|class)[ \\t]+([\\w$]+)",
          "kind": "function",
          "name": 1
        }
      ]
    },
    {
      "id": "javascript-package",
      "name": "npm package",
      "filenames": [
        "package.json"
      ],
      "brackets": [
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "braces",
        "size": 2
      },
      "fold": "braces",
      "check": [
        "brackets"
      ],
      "grammar": [
        {
          "match": "(\"(?:[^\"\\\\\\n]|\\\\.)*\")[ \\t]*:",
          "captures": {
            "1": "argument"
          }
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "words": [
            "true",
            "false",
            "null"
          ],
          "class": "constant"
        },
        {
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
          "class": "number"
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*\"([^\"\\n]+)\"[ \\t]*:",
          "kind": "variable",
          "name": 1
        }
      ]
    }
  ],
  "run": [
    {
      "language": "javascript",
      "name": "Node: Run file",
      "command": "node \"{file}\""
    },
    {
      "language": "javascript",
      "name": "Node: Watch file",
      "command": "node --watch \"{file}\""
    },
    {
      "language": "javascript",
      "name": "Node: Test file",
      "command": "node --test \"{file}\""
    },
    {
      "language": "javascript-package",
      "name": "npm: Install dependencies",
      "command": "npm --prefix \"{dir}\" install"
    },
    {
      "language": "javascript-package",
      "name": "npm: Start",
      "command": "npm --prefix \"{dir}\" start"
    },
    {
      "language": "javascript-package",
      "name": "npm: Development server",
      "command": "npm --prefix \"{dir}\" run dev"
    },
    {
      "language": "javascript-package",
      "name": "npm: Build",
      "command": "npm --prefix \"{dir}\" run build"
    },
    {
      "language": "javascript-package",
      "name": "npm: Test",
      "command": "npm --prefix \"{dir}\" test"
    },
    {
      "language": "javascript-package",
      "name": "npm: Lint",
      "command": "npm --prefix \"{dir}\" run lint"
    }
  ],
  "check": [
    {
      "language": "javascript",
      "name": "Node syntax",
      "command": "node --check \"{file}\"",
      "pattern": "(?m)^(?P<file>[^\\n]+):(?P<line>\\d+)\\r?\\n(?:[^\\n]*\\n)*?SyntaxError: (?P<msg>[^\\n]+)"
    }
  ],
  "tools": [
    {
      "name": "Node.js and npm",
      "programs": [
        "node",
        "npm"
      ],
      "required": [
        "node",
        "npm"
      ],
      "apt": "nodejs npm"
    }
  ],
  "detect": {
    "extensions": [
      "js",
      "mjs",
      "cjs",
      "jsx"
    ],
    "files": [
      "package.json",
      "package-lock.json",
      "yarn.lock",
      "pnpm-lock.yaml"
    ]
  }
}
