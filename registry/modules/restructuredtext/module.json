{
  "version": "1.1.1",
  "cover": "cover.png",
  "license": "MIT",
  "author": "Light contributors",
  "id": "restructuredtext",
  "name": "reStructuredText",
  "category": "Documents",
  "summary": "Headings by underline, directives, roles, links and lists for .rst; folding and an outline by sections.",
  "description": "reStructuredText for Light (the markup of Sphinx and Python documentation): headings found by their underlines - the first style of underline is the top level - directives, hyperlink targets, comments, roles, literals, emphasis and links are coloured; Enter continues a list; the outline and folding follow the sections. A rendered preview shows the document next to the code or instead of it (Editor, Editor and Preview, Preview).",
  "languages": [
    {
      "id": "rst",
      "name": "reStructuredText",
      "extensions": [
        "rst",
        "rest"
      ],
      "filenames": [],
      "line_comment": "..",
      "brackets": [],
      "indent": {
        "mode": "markup",
        "size": 3
      },
      "fold": "headings",
      "preview": "rst",
      "grammar": [
        {
          "match": "^[^\\s.\\n][^\\n]*\\n[=\\-~^\\\"'#*+:._`]{3,}[ \\t]*$",
          "class": "heading"
        },
        {
          "match": "^(\\.\\.)[ \\t]+([A-Za-z][\\w+.:-]*)(::)",
          "captures": {
            "1": "preproc",
            "2": "keyword",
            "3": "preproc"
          }
        },
        {
          "match": "^\\.\\.[ \\t]+_[^\\n:]+:.*$",
          "class": "link"
        },
        {
          "match": "^\\.\\.[ \\t]+\\[[^\\]\\n]+\\].*$",
          "class": "link"
        },
        {
          "match": "^\\.\\.[ \\t]+\\|[^|\\n]+\\|.*$",
          "class": "link"
        },
        {
          "match": "^\\.\\.(?:[ \\t].*)?$",
          "class": "comment"
        },
        {
          "match": "::[ \\t]*$",
          "class": "prefix"
        },
        {
          "match": "^[ \\t]*:[A-Za-z][\\w -]*:(?:[ \\t]|$)",
          "class": "builtin"
        },
        {
          "match": "(:[A-Za-z][\\w:+.-]*:)(`[^`\\n]+`)",
          "captures": {
            "1": "keyword",
            "2": "link"
          }
        },
        {
          "match": "``[^`\\n]+``",
          "class": "code"
        },
        {
          "match": "`[^`\\n]+`__?",
          "class": "link"
        },
        {
          "match": "`[^`\\n]+`",
          "class": "emphasis"
        },
        {
          "match": "\\*\\*[^*\\n]+\\*\\*",
          "class": "strong"
        },
        {
          "match": "\\*[^*\\s][^*\\n]*\\*",
          "class": "emphasis"
        },
        {
          "match": "\\[(?:\\d+|#\\w*|\\*)\\]_",
          "class": "link"
        },
        {
          "match": "\\|[^|\\s][^|\\n]*\\|_{0,2}",
          "class": "link"
        },
        {
          "match": "https?://[^\\s)>\\]]+",
          "class": "link"
        },
        {
          "match": "^[ \\t]*(?:[-*+•]|\\d+\\.|#\\.|[a-zA-Z]\\.|\\(\\d+\\))[ \\t]+",
          "class": "prefix"
        },
        {
          "match": "^[ \\t]*\\+[-=+]+\\+[ \\t]*$|^[ \\t]*=+(?:[ \\t]+=+)+[ \\t]*$",
          "class": "prefix"
        },
        {
          "match": "^\\|[ \\t]",
          "class": "prefix"
        }
      ],
      "outline": [
        {
          "pattern": "^([^\\s.\\n][^\\n]*)\\n([=\\-~^\\\"'#*+:._`]{3,})[ \\t]*$",
          "kind": "heading",
          "name": 1,
          "level": 2,
          "level_mode": "first_seen"
        }
      ]
    }
  ],
  "run": [],
  "tools": [],
  "detect": {
    "extensions": [
      "rst"
    ],
    "files": [
      "conf.py"
    ]
  },
  "templates": [
    {
      "name": "Document",
      "description": "index.rst",
      "open": "index.rst",
      "files": {
        "index.rst": "Title\n=====\n\nIntroduction\n------------\n\nSome *emphasis*, some **strong** text and ``literal`` code.\n\n.. note::\n\n   A directive.\n\n- first\n- second\n"
      }
    }
  ]
}
