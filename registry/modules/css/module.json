              "match": "(?i:\\burl)\\(\\s*(?:[^)\"'\\\\]|\\\\.|\"[^\"]*\"|'[^']*')*(?:\\)|$)",
              "class": "string"
            },
            {
              "match": "#[0-9A-Fa-f]{3,8}\\b",
              "class": "number"
