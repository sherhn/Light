{
  "version": "1.1.1",
  "cover": "cover.png",
  "license": "MIT",
  "author": "Light contributors",
  "id": "python",
  "name": "Python",
  "category": "Languages",
  "summary": "Highlighting, indentation, folding by blocks and an outline for Python; run a file; python3 and pip in Linux.",
  "description": "Python for Light: strings of every kind (triple-quoted, f-strings, raw), decorators, keywords, builtins and numbers; Enter after a colon indents and return/pass dedent; folding by indentation; the outline of classes and functions; a command to run the current file. The Linux side brings python3, pip and venv - installed from inside the IDE.",
  "languages": [
    {
      "id": "python",
      "name": "Python",
      "extensions": [
        "py",
        "pyw",
        "pyi",
        "pyx"
      ],
      "filenames": [
        "SConstruct",
        "SConscript",
        "Pipfile"
      ],
      "first_line": "^#!.*\\bpython",
      "line_comment": "#",
      "brackets": [
        "()",
        "[]",
        "{}"
      ],
      "check": [
        "brackets"
      ],
      "indent": {
        "mode": "python",
        "size": 4
      },
      "fold": "indent",
      "grammar": [
        {
          "begin": "(?:[rRbBuUfF]{1,2})?\"\"\"",
          "end": "\"\"\"",
          "class": "string"
        },
        {
          "begin": "(?:[rRbBuUfF]{1,2})?'''",
          "end": "'''",
          "class": "string"
        },
        {
          "match": "#.*$",
          "class": "comment"
        },
        {
          "match": "(?:[rRbBuUfF]{1,2})?\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "match": "(?:[rRbBuUfF]{1,2})?'(?:[^'\\\\\\n]|\\\\.)*'?",
          "class": "string"
        },
        {
          "match": "^[ \\t]*(@[A-Za-z_][\\w.]*)",
          "captures": {
            "1": "decorator"
          }
        },
        {
          "match": "\\b(class)[ \\t]+([A-Za-z_]\\w*)",
          "captures": {
            "1": "keyword",
            "2": "type"
          }
        },
        {
          "match": "\\b(def)[ \\t]+([A-Za-z_]\\w*)",
          "captures": {
            "1": "keyword",
            "2": "function"
          }
        },
        {
          "words": [
            "and",
            "as",
            "assert",
            "async",
            "await",
            "break",
            "class",
            "continue",
            "def",
            "del",
            "elif",
            "else",
            "except",
            "finally",
            "for",
            "from",
            "global",
            "if",
            "import",
            "in",
            "is",
            "lambda",
            "nonlocal",
            "not",
            "or",
            "pass",
            "raise",
            "return",
            "try",
            "while",
            "with",
            "yield",
            "match",
            "case"
          ],
          "class": "keyword"
        },
        {
          "words": [
            "True",
            "False",
            "None",
            "NotImplemented",
            "Ellipsis",
            "__name__",
            "__main__",
            "__file__"
          ],
          "class": "constant"
        },
        {
          "words": [
            "self",
            "cls"
          ],
          "class": "variable"
        },
        {
          "words": [
            "print",
            "len",
            "range",
            "int",
            "str",
            "float",
            "list",
            "dict",
            "set",
            "tuple",
            "bool",
            "bytes",
            "bytearray",
            "type",
            "isinstance",
            "issubclass",
            "enumerate",
            "zip",
            "map",
            "filter",
            "sum",
            "min",
            "max",
            "abs",
            "open",
            "sorted",
            "reversed",
            "any",
            "all",
            "input",
            "super",
            "object",
            "repr",
            "hash",
            "id",
            "iter",
            "next",
            "round",
            "pow",
            "divmod",
            "format",
            "vars",
            "dir",
            "getattr",
            "setattr",
            "hasattr",
            "callable",
            "chr",
            "ord",
            "hex",
            "oct",
            "bin",
            "slice",
            "property",
            "staticmethod",
            "classmethod",
            "frozenset",
            "memoryview",
            "complex",
            "compile",
            "eval",
            "exec",
            "globals",
            "locals",
            "Exception",
            "BaseException",
            "ValueError",
            "TypeError",
            "KeyError",
            "IndexError",
            "AttributeError",
            "RuntimeError",
            "OSError",
            "IOError",
            "ImportError",
            "NameError",
            "StopIteration",
            "NotImplementedError",
            "ZeroDivisionError",
            "AssertionError",
            "KeyboardInterrupt",
            "FileNotFoundError",
            "PermissionError"
          ],
          "class": "builtin"
        },
        {
          "match": "\\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.[\\d_]*)?(?:[eE][+-]?\\d+)?[jJ]?|\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?[jJ]?)\\b",
          "class": "number"
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\(",
          "captures": {
            "1": "function"
          },
          "consume": 1
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*(?:async[ \\t]+)?def[ \\t]+(\\w+)",
          "kind": "function",
          "name": 1
        },
        {
          "pattern": "^[ \\t]*class[ \\t]+(\\w+)",
          "kind": "class",
          "name": 1
        }
      ]
    }
  ],
  "check": [
    {
      "language": "python",
      "name": "Syntax",
      "command": "python3 -c \"import sys;compile(open(sys.argv[1],encoding='utf-8').read(),sys.argv[1],'exec')\" \"{file}\"",
      "windows": "where py >nul 2>nul & if errorlevel 1 (python -c \"import sys;compile(open(sys.argv[1],encoding='utf-8').read(),sys.argv[1],'exec')\" \"{file}\") else (py -c \"import sys;compile(open(sys.argv[1],encoding='utf-8').read(),sys.argv[1],'exec')\" \"{file}\")",
      "pattern": "(?s)File \"(?P<file>[^<\"][^\"]*)\", line (?P<line>\\d+)\\n.*?(?P<sev>SyntaxError|IndentationError|TabError)[^:\\n]*: (?P<msg>[^\\n]*)"
    }
  ],
  "run": [
    {
      "language": "python",
      "name": "Run file",
      "command": "python3 \"{file}\"",
      "windows": "where py >nul 2>nul & if errorlevel 1 (python \"{file}\") else (py \"{file}\")"
    }
  ],
  "tools": [
    {
      "name": "Python",
      "programs": [
        "python3",
        "pip3"
      ],
      "apt": "python3 python3-pip python3-venv"
    }
  ],
  "detect": {
    "extensions": [
      "py",
      "pyw"
    ],
    "files": [
      "pyproject.toml",
      "requirements.txt",
      "setup.py",
      "Pipfile"
    ]
  },
  "templates": [
    {
      "name": "Script",
      "description": "main.py",
      "open": "main.py",
      "files": {
        "main.py": "def main():\n    print(\"Hello, Light\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
      }
    },
    {
      "name": "Package with tests",
      "description": "a package, a test and requirements",
      "open": "app/core.py",
      "files": {
        "pyproject.toml": "[project]\nname = \"app\"\nversion = \"0.1.0\"\n",
        "requirements.txt": "pytest\n",
        "app/__init__.py": "\"\"\"A small package.\"\"\"\n",
        "app/core.py": "def add(a, b):\n    return a + b\n",
        "tests/test_core.py": "from app.core import add\n\n\ndef test_add():\n    assert add(2, 3) == 5\n"
      }
    }
  ]
}
