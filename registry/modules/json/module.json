{
  "version": "1.0.1",
  "cover": "cover.png",
  "license": "MIT",
  "author": "Light contributors",
  "id": "json",
  "name": "JSON",
  "category": "Languages",
  "summary": "JSON, JSON Lines and JSON with comments: highlighting, key outline, indentation and folding.",
  "description": "Standalone JSON support without Node.js. Keys, strings, numbers and constants, bracket checks, key navigation and brace folding. JSONC additionally supports line and block comments; strict JSON keeps comments disabled. Includes JSON Lines (.jsonl and .ndjson).",
  "languages": [
    {
      "id": "json",
      "name": "JSON",
      "extensions": [
        "json",
        "jsonl",
        "ndjson"
      ],
      "brackets": [
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "braces",
        "size": 2
      },
      "fold": "braces",
      "check": [
        "brackets"
      ],
      "grammar": [
        {
          "match": "(\"(?:[^\"\\\\\\n]|\\\\.)*\")[ \\t]*:",
          "captures": {
            "1": "argument"
          }
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "words": [
            "true",
            "false",
            "null"
          ],
          "class": "constant"
        },
        {
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
          "class": "number"
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*\"((?:[^\"\\\\\\n]|\\\\.)*)\"[ \\t]*:",
          "kind": "variable",
          "name": 1
        }
      ]
    },
    {
      "id": "jsonc",
      "name": "JSON with comments",
      "extensions": [
        "jsonc"
      ],
      "brackets": [
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "braces",
        "size": 2
      },
      "fold": "braces",
      "check": [
        "brackets"
      ],
      "line_comment": "//",
      "block_comment": [
        "/*",
        "*/"
      ],
      "grammar": [
        {
          "match": "//[^\\n]*",
          "class": "comment"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "class": "comment"
        },
        {
          "match": "(\"(?:[^\"\\\\\\n]|\\\\.)*\")[ \\t]*:",
          "captures": {
            "1": "argument"
          }
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "words": [
            "true",
            "false",
            "null"
          ],
          "class": "constant"
        },
        {
          "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b",
          "class": "number"
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*\"((?:[^\"\\\\\\n]|\\\\.)*)\"[ \\t]*:",
          "kind": "variable",
          "name": 1
        }
      ]
    }
  ],
  "detect": {
    "extensions": [
      "json",
      "jsonl",
      "ndjson",
      "jsonc"
    ],
    "files": []
  }
}
