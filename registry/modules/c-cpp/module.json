  "run": [
    {
      "language": "c",
      "name": "Compile and run file",
      "command": "cc -g -Wall -Wextra \"{file}\" -o \"{dir}/{stem}\" && \"{dir}/{stem}\"",
      "windows": "gcc -g -Wall -Wextra \"{file}\" -o \"{dir}/{stem}.exe\" && \"{dir}/{stem}.exe\""
    },
    {
      "language": "cpp",
      "name": "Compile and run file",
      "command": "c++ -g -Wall -Wextra -std=c++17 \"{file}\" -o \"{dir}/{stem}\" && \"{dir}/{stem}\"",
      "windows": "g++ -g -Wall -Wextra -std=c++17 \"{file}\" -o \"{dir}/{stem}.exe\" && \"{dir}/{stem}.exe\""
    },
    {
      "language": "c",
      "name": "Run with AddressSanitizer",
      "command": "cc -g -O1 -fno-omit-frame-pointer -fsanitize=address,undefined \"{file}\" -o \"{dir}/{stem}-asan\" && \"{dir}/{stem}-asan\""
    },
    {
      "language": "c",
      "name": "Run under Valgrind",
      "command": "cc -g -O0 \"{file}\" -o \"{dir}/{stem}\" && valgrind --leak-check=full --error-exitcode=1 \"{dir}/{stem}\""
    },
    {
      "language": "cpp",
      "name": "Run with AddressSanitizer",
      "command": "c++ -g -O1 -fno-omit-frame-pointer -fsanitize=address,undefined -std=c++17 \"{file}\" -o \"{dir}/{stem}-asan\" && \"{dir}/{stem}-asan\""
    },
    {
      "language": "cpp",
      "name": "Run under Valgrind",
      "command": "c++ -g -O0 -std=c++17 \"{file}\" -o \"{dir}/{stem}\" && valgrind --leak-check=full --error-exitcode=1 \"{dir}/{stem}\""
    }
  ],
  "tasks": [
    {
      "name": "CMake",
      "files": [
        "CMakeLists.txt"
      ],
      "skip": [
        "build",
        "_deps"
      ],
      "pattern": "(?m)^[ \\t]*add_(?:executable|library)[ \\t]*\\([ \\t]*(?P<name>[A-Za-z_][\\w.+-]*)",
      "command": "cmake --build \"{root}/build\" --target {task}",
      "fixed": [
        {
          "name": "configure",
          "command": "cmake -S \"{root}\" -B \"{root}/build\" -DCMAKE_BUILD_TYPE=Debug"
        },
        {
          "name": "build",
          "command": "cmake --build \"{root}/build\""
        },
        {
          "name": "test",
          "command": "ctest --test-dir \"{root}/build\" --output-on-failure"
        },
        {
          "name": "clean",
          "command": "cmake --build \"{root}/build\" --target clean"
        }
      ]
    },
    {
      "name": "CMake configure presets",
      "files": [
        "CMakePresets.json",
        "CMakeUserPresets.json"
      ],
      "json": "configurePresets",
      "command": "cmake --preset {task}"
    },
    {
      "name": "CMake build presets",
      "files": [
        "CMakePresets.json",
        "CMakeUserPresets.json"
      ],
      "json": "buildPresets",
      "command": "cmake --build --preset {task}"
    },
    {
      "name": "CMake test presets",
      "files": [
        "CMakePresets.json",
        "CMakeUserPresets.json"
      ],
      "json": "testPresets",
      "command": "ctest --preset {task} --output-on-failure"
    }
  ],
  "tests": [
    {
      "name": "GoogleTest",
      "languages": [
        "cpp"
      ],
      "content": "#\\s*include\\s*[<\\\"]gtest/",
      "separator": ".",
      "test": "^\\s*(?:TEST|TEST_F|TEST_P|TYPED_TEST|TYPED_TEST_P)\\(\\s*(?P<suite>\\w+)\\s*,\\s*(?P<name>\\w+)\\s*\\)",
      "command": "cmake --build \"{root}/build\" && ctest --test-dir \"{root}/build\" --output-on-failure -R \"{test}\"",
      "file_command": "cmake --build \"{root}/build\" && ctest --test-dir \"{root}/build\" --output-on-failure",
      "passed": "(?m)^\\s*\\d+/\\d+ Test\\s+#\\d+: (?P<name>.+?) \\.+\\s+Passed",
      "failed": "(?m)^\\s*\\d+/\\d+ Test\\s+#\\d+: (?P<name>.+?) \\.+\\s*\\*\\*\\****(?:Failed|Exception|Timeout|Not Run)"
    },
    {
      "name": "Catch2",
      "languages": [
        "cpp"
      ],
      "content": "#\\s*include\\s*[<\\\"]catch2?/|catch\\.hpp",
      "separator": " ",
      "test": "^\\s*(?:TEST_CASE|SCENARIO|TEMPLATE_TEST_CASE)\\(\\s*(?:\"(?P<name>[^\"\\n]*)\")",
      "command": "cmake --build \"{root}/build\" && ctest --test-dir \"{root}/build\" --output-on-failure -R \"{test}\"",
      "file_command": "cmake --build \"{root}/build\" && ctest --test-dir \"{root}/build\" --output-on-failure",
      "passed": "(?m)^\\s*\\d+/\\d+ Test\\s+#\\d+: (?P<name>.+?) \\.+\\s+Passed",
      "failed": "(?m)^\\s*\\d+/\\d+ Test\\s+#\\d+: (?P<name>.+?) \\.+\\s*\\*\\*\\****(?:Failed|Exception|Timeout|Not Run)"
    },
    {
      "name": "doctest",
      "languages": [
        "c",
        "cpp"
      ],
      "content": "#\\s*include\\s*[<\\\"](?:doctest/)?doctest\\.h",
      "separator": " ",
      "test": "^\\s*(?:TEST_CASE|SCENARIO)\\(\\s*(?:\"(?P<name>[^\"\\n]*)\")",
      "command": "cmake --build \"{root}/build\" && ctest --test-dir \"{root}/build\" --output-on-failure -R \"{test}\"",
      "file_command": "cmake --build \"{root}/build\" && ctest --test-dir \"{root}/build\" --output-on-failure",
      "passed": "(?m)^\\s*\\d+/\\d+ Test\\s+#\\d+: (?P<name>.+?) \\.+\\s+Passed",
      "failed": "(?m)^\\s*\\d+/\\d+ Test\\s+#\\d+: (?P<name>.+?) \\.+\\s*\\*\\*\\****(?:Failed|Exception|Timeout|Not Run)"
    }
  ],
  "debug": [
    {
      "name": "GDB",
      "languages": [
        "c"
      ],
      "adapter_id": "gdb",
      "transport": "stdio",
      "command": [
        "gdb",
        "-q",
        "-i",
        "dap"
      ],
      "prepare": "cc -g -O0 \"{file}\" -o \"{dir}/{stem}\"",
      "windows_prepare": "gcc -g -O0 \"{file}\" -o \"{dir}/{stem}.exe\"",
      "launch": {
        "program": "{dir}/{stem}{exe}",
        "cwd": "{dir}",
        "stopAtBeginningOfMainSubprogram": false
      }
    },
    {
      "name": "GDB",
      "languages": [
        "cpp"
      ],
      "adapter_id": "gdb",
      "transport": "stdio",
      "command": [
        "gdb",
        "-q",
        "-i",
        "dap"
      ],
      "prepare": "c++ -g -O0 -std=c++17 \"{file}\" -o \"{dir}/{stem}\"",
      "windows_prepare": "g++ -g -O0 -std=c++17 \"{file}\" -o \"{dir}/{stem}.exe\"",
      "launch": {
        "program": "{dir}/{stem}{exe}",
        "cwd": "{dir}",
        "stopAtBeginningOfMainSubprogram": false
      }
    }
  ],
  "tools": [
    {
      "name": "C and C++",
      "required": [
        "make",
        "gcc"
      ],
      "programs": [
        "make",
        "gcc",
        "g++",
        "ld",
        "gdb",
        "cmake",
        "ninja",
        "pkg-config"
      ],
      "apt": "build-essential gdb cmake ninja-build pkg-config autoconf automake libtool ccache bear gcc-multilib g++-multilib"
    },
    {
      "name": "Clang and LLVM",
      "programs": [
        "clang",
        "clangd",
        "lldb",
        "clang-format"
      ],
      "apt": "clang clangd lldb clang-format clang-tidy"
    },
    {
      "name": "Debugging and analysis",
      "programs": [
        "valgrind",
        "strace",
        "ltrace",
        "gdb-multiarch",
        "xxd"
      ],
      "apt": "valgrind strace ltrace gdb-multiarch xxd"
    }
  ],
  "detect": {
    "extensions": [
      "c",
      "h",
      "cc",
      "cpp",
      "cxx",
      "hpp",
      "hh",
      "hxx"
    ],
    "files": [
      "CMakeLists.txt",
      "meson.build",
      "Makefile",
      "makefile",
      "GNUmakefile"
    ]
  },
  "templates": [
    {
      "name": "C program",
      "description": "main.c and a makefile",
      "open": "main.c",
      "files": {
        "main.c": "#include <stdio.h>\n\nint main(void) {\n    printf(\"Hello, Light\\n\");\n    return 0;\n}\n",
        "makefile": "CFLAGS = -g -Wall -Wextra\n\nall: main\n\nmain: main.c\n\t$(CC) $(CFLAGS) main.c -o main\n\nrun: main\n\t./main\n\nclean:\n\trm -f main\n\n.PHONY: all run clean\n"
      }
    },
    {
      "name": "C++ program",
      "description": "main.cpp and a CMake project",
      "open": "main.cpp",
      "files": {
        "main.cpp": "#include <iostream>\n\nint main() {\n    std::cout << \"Hello, Light\\n\";\n}\n",
        "CMakeLists.txt": "cmake_minimum_required(VERSION 3.16)\nproject(hello CXX)\nset(CMAKE_CXX_STANDARD 17)\nadd_executable(hello main.cpp)\n"
      }
    }
  ]
}
