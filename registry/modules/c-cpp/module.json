{
  "version": "1.1.1",
  "cover": "cover.png",
  "license": "MIT",
  "author": "Light contributors",
  "id": "c-cpp",
  "name": "C and C++",
  "category": "Languages",
  "summary": "Highlighting, brackets, folding and an outline for C, C++ and headers; compile and run a file; the compilers and debuggers in Linux.",
  "description": "C and C++ for Light: syntax highlighting with preprocessor and types, matching brackets, folding of blocks, the outline of functions, structs and macros, Enter after a brace indents, and a command to compile and run the current file. The Linux side brings gcc, g++, make, cmake, ninja, gdb, clang, clangd, valgrind and friends - installed from inside the IDE.",
  "languages": [
    {
      "id": "c",
      "name": "C",
      "extensions": [
        "c",
        "h",
        "ld",
        "lds"
      ],
      "filenames": [],
      "grammar": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "class": "comment"
        },
        {
          "match": "//.*$",
          "class": "comment"
        },
        {
          "match": "(?:u8|[LuU])?\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "match": "(?:u8|[LuU])?'(?:[^'\\\\\\n]|\\\\.)*'?",
          "class": "char"
        },
        {
          "match": "^[ \\t]*(#[ \\t]*include(?:_next)?)[ \\t]*(<[^>\\n]*>)?",
          "captures": {
            "1": "preproc",
            "2": "string"
          }
        },
        {
          "match": "^[ \\t]*#[ \\t]*(?:define|undef|if|ifdef|ifndef|else|elif|elifdef|elifndef|endif|error|warning|pragma|line|import)\\b",
          "class": "preproc"
        },
        {
          "match": "\\b(?:0[xX][0-9a-fA-F']+|0[bB][01']+|\\d[\\d']*(?:\\.\\d*)?(?:[eE][+-]?\\d+)?|\\.\\d+(?:[eE][+-]?\\d+)?)[uUlLfF]*\\b",
          "class": "number"
        },
        {
          "words": [
            "if",
            "else",
            "for",
            "while",
            "do",
            "switch",
            "case",
            "default",
            "break",
            "continue",
            "return",
            "goto",
            "sizeof",
            "typedef",
            "struct",
            "union",
            "enum",
            "static",
            "extern",
            "const",
            "volatile",
            "inline",
            "register",
            "restrict",
            "auto",
            "asm",
            "__asm__",
            "__attribute__",
            "__volatile__",
            "__inline__",
            "_Alignas",
            "_Alignof",
            "_Atomic",
            "_Generic",
            "_Noreturn",
            "_Static_assert",
            "_Thread_local",
            "alignas",
            "alignof"
          ],
          "class": "keyword"
        },
        {
          "words": [
            "void",
            "char",
            "short",
            "int",
            "long",
            "float",
            "double",
            "signed",
            "unsigned",
            "bool",
            "_Bool",
            "_Complex",
            "size_t",
            "ssize_t",
            "ptrdiff_t",
            "intptr_t",
            "uintptr_t",
            "intmax_t",
            "uintmax_t",
            "int8_t",
            "int16_t",
            "int32_t",
            "int64_t",
            "uint8_t",
            "uint16_t",
            "uint32_t",
            "uint64_t",
            "wchar_t",
            "char8_t",
            "char16_t",
            "char32_t",
            "FILE",
            "va_list",
            "off_t",
            "time_t",
            "string",
            "vector",
            "map",
            "set",
            "unique_ptr",
            "shared_ptr"
          ],
          "class": "type"
        },
        {
          "words": [
            "NULL",
            "true",
            "false",
            "nullptr",
            "EOF",
            "stdin",
            "stdout",
            "stderr",
            "__FILE__",
            "__LINE__",
            "__func__",
            "__cplusplus"
          ],
          "class": "constant"
        },
        {
          "match": "\\b([A-Za-z_]\\w*)\\(",
          "captures": {
            "1": "function"
          },
          "consume": 1
        }
      ],
      "line_comment": "//",
      "block_comment": [
        "/*",
        "*/"
      ],
      "brackets": [
        "()",
        "[]",
        "{}"
      ],
      "check": [
        "brackets"
      ],
      "indent": {
        "mode": "braces",
        "size": 4
      },
      "fold": "braces",
      "outline": [
        {
          "pattern": "^[A-Za-z_][\\w \\t\\*&:<>~,]*?\\b(\\w+)[ \\t]*\\([^;(){}]*\\)\\s*(?:const\\s*)?(?:noexcept\\s*)?\\{",
          "kind": "function",
          "name": 1
        },
        {
          "pattern": "^(?:typedef[ \\t]+)?(?:struct|union)[ \\t]+(\\w+)",
          "kind": "struct",
          "name": 1
        },
        {
          "pattern": "^(?:typedef[ \\t]+)?enum(?:[ \\t]+class)?[ \\t]+(\\w+)",
          "kind": "type",
          "name": 1
        },
        {
          "pattern": "^[ \\t]*(?:class|namespace)[ \\t]+(\\w+)",
          "kind": "class",
          "name": 1
        },
        {
          "pattern": "^[ \\t]*#[ \\t]*define[ \\t]+(\\w+)",
          "kind": "macro",
          "name": 1
        }
      ]
    },
