  "run": [
    {
      "language": "c",
      "name": "Compile and run file",
      "command": "cc -g -Wall -Wextra \"{file}\" -o \"{dir}/{stem}\" && \"{dir}/{stem}\"",
      "windows": "gcc -g -Wall -Wextra \"{file}\" -o \"{dir}/{stem}.exe\" && \"{dir}/{stem}.exe\""
    },
    {
      "language": "cpp",
      "name": "Compile and run file",
      "command": "c++ -g -Wall -Wextra -std=c++17 \"{file}\" -o \"{dir}/{stem}\" && \"{dir}/{stem}\"",
      "windows": "g++ -g -Wall -Wextra -std=c++17 \"{file}\" -o \"{dir}/{stem}.exe\" && \"{dir}/{stem}.exe\""
    }
  ],
  "tools": [
    {
      "name": "C and C++",
      "required": [
        "make",
        "gcc"
      ],
      "programs": [
        "make",
        "gcc",
        "g++",
        "ld",
        "gdb",
        "cmake",
        "ninja",
        "pkg-config"
      ],
      "apt": "build-essential gdb cmake ninja-build pkg-config autoconf automake libtool ccache bear gcc-multilib g++-multilib"
    },
    {
      "name": "Clang and LLVM",
      "programs": [
        "clang",
        "clangd",
        "lldb",
        "clang-format"
      ],
      "apt": "clang clangd lldb clang-format clang-tidy"
    },
    {
      "name": "Debugging and analysis",
      "programs": [
        "valgrind",
        "strace",
        "ltrace",
        "gdb-multiarch",
        "xxd"
      ],
      "apt": "valgrind strace ltrace gdb-multiarch xxd"
    }
  ],
  "detect": {
    "extensions": [
      "c",
      "h",
      "cc",
      "cpp",
      "cxx",
      "hpp",
      "hh",
      "hxx"
    ],
    "files": [
      "CMakeLists.txt",
      "meson.build",
      "Makefile",
      "makefile",
      "GNUmakefile"
    ]
  },
  "templates": [
    {
      "name": "C program",
      "description": "main.c and a makefile",
      "open": "main.c",
      "files": {
        "main.c": "#include <stdio.h>\n\nint main(void) {\n    printf(\"Hello, Light\\n\");\n    return 0;\n}\n",
        "makefile": "CFLAGS = -g -Wall -Wextra\n\nall: main\n\nmain: main.c\n\t$(CC) $(CFLAGS) main.c -o main\n\nrun: main\n\t./main\n\nclean:\n\trm -f main\n\n.PHONY: all run clean\n"
      }
    },
    {
      "name": "C++ program",
      "description": "main.cpp and a CMake project",
      "open": "main.cpp",
      "files": {
        "main.cpp": "#include <iostream>\n\nint main() {\n    std::cout << \"Hello, Light\\n\";\n}\n",
        "CMakeLists.txt": "cmake_minimum_required(VERSION 3.16)\nproject(hello CXX)\nset(CMAKE_CXX_STANDARD 17)\nadd_executable(hello main.cpp)\n"
      }
    }
  ]
