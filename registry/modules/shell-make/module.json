{
  "version": "1.1.1",
  "cover": "cover.png",
  "license": "MIT",
  "author": "Light contributors",
  "id": "shell-make",
  "name": "Shell and Make",
  "category": "Languages",
  "summary": "Shell scripts, makefiles and the usual configuration files: highlighting, comments and an outline of functions and targets.",
  "description": "Shell scripts (sh, bash, zsh), makefiles and configuration files (YAML, TOML, INI, CMake, Dockerfile, .gitignore) for Light: comments, strings, variables, keywords and builtins, make targets and recipes, the outline of functions and targets, and Comment Line with #. Make targets also appear as run configurations.",
  "languages": [
    {
      "id": "shell",
      "name": "Shell",
      "extensions": [
        "sh",
        "bash",
        "zsh",
        "ksh",
        "bashrc",
        "profile",
        "bash_profile",
        "zshrc"
      ],
      "filenames": [
        ".bashrc",
        ".profile",
        ".bash_profile",
        ".zshrc"
      ],
      "first_line": "^#!.*\\b(?:ba|z|k|da)?sh\\b",
      "line_comment": "#",
      "brackets": [
        "()",
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "keep",
        "size": 2
      },
      "fold": "none",
      "grammar": [
        {
          "match": "^#!.*$",
          "class": "preproc"
        },
        {
          "match": "(?:^|[ \\t;|&(])(#.*)$",
          "captures": {
            "1": "comment"
          }
        },
        {
          "match": "\"(?:[^\"\\\\]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "match": "'[^']*'?",
          "class": "string"
        },
        {
          "match": "\\$\\{[^}\\n]*\\}|\\$[A-Za-z_]\\w*|\\$[@*#?$!0-9-]",
          "class": "variable"
        },
        {
          "match": "^[ \\t]*(?:function[ \\t]+)?([A-Za-z_][\\w-]*)[ \\t]*\\(\\)",
          "captures": {
            "1": "function"
          },
          "consume": 1
        },
        {
          "words": [
            "if",
            "then",
            "else",
            "elif",
            "fi",
            "for",
            "while",
            "until",
            "do",
            "done",
            "case",
            "esac",
            "in",
            "function",
            "select",
            "time",
            "coproc"
          ],
          "class": "keyword"
        },
        {
          "words": [
            "echo",
            "printf",
            "cd",
            "pwd",
            "test",
            "read",
            "return",
            "break",
            "continue",
            "exit",
            "local",
            "export",
            "readonly",
            "declare",
            "typeset",
            "unset",
            "shift",
            "source",
            "alias",
            "unalias",
            "eval",
            "exec",
            "trap",
            "set",
            "wait",
            "kill",
            "jobs",
            "fg",
            "bg",
            "let",
            "getopts",
            "type",
            "command",
            "builtin",
            "umask",
            "ulimit",
            "true",
            "false"
          ],
          "class": "builtin"
        },
        {
          "words": [
            "ls",
            "cat",
            "grep",
            "sed",
            "awk",
            "find",
            "mkdir",
            "rm",
            "cp",
            "mv",
            "chmod",
            "chown",
            "ln",
            "tar",
            "curl",
            "wget",
            "git",
            "make",
            "sudo",
            "apt",
            "dpkg",
            "ssh",
            "scp",
            "rsync",
            "tee",
            "head",
            "tail",
            "sort",
            "uniq",
            "wc",
            "xargs",
            "cut",
            "tr",
            "diff",
            "patch",
            "gzip",
            "gunzip",
            "zip",
            "unzip",
            "which",
            "whoami",
            "uname",
            "date",
            "sleep",
            "touch",
            "basename",
            "dirname",
            "python3",
            "pip3",
            "cc",
            "gcc",
            "nasm"
          ],
          "class": "type"
        },
        {
          "match": "\b(?:apt-get|qemu-system-[A-Za-z0-9_]+)\b",
          "class": "type"
        },
        {
          "match": "\\b\\d+\\b",
          "class": "number"
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*(?:function[ \\t]+)?([A-Za-z_][\\w-]*)[ \\t]*\\(\\)",
          "kind": "function",
          "name": 1
        }
      ]
    },
    {
      "id": "make",
      "name": "Makefile",
      "extensions": [
        "mk",
        "mak"
      ],
      "filenames": [
        "Makefile",
        "makefile",
        "GNUmakefile"
      ],
      "line_comment": "#",
      "brackets": [
        "()",
        "{}"
      ],
      "indent": {
        "mode": "keep",
        "size": 4
      },
      "fold": "none",
      "grammar": [
        {
          "match": "#.*$",
          "class": "comment"
        },
        {
          "match": "^\\t[@+-]+",
          "class": "prefix"
        },
        {
          "match": "^[ \\t]*(?:-?include|sinclude|ifeq|ifneq|ifdef|ifndef|else|endif|define|endef|export|unexport|override|private|vpath|undefine)\\b",
          "class": "preproc"
        },
        {
          "match": "^[ \\t]*(\\.[A-Z_]+)[ \\t]*:",
          "captures": {
            "1": "preproc"
          },
          "consume": 1
        },
        {
          "match": "^[ \\t]*([A-Za-z_][\\w.]*)[ \\t]*(?:[:?+!]?=)",
          "captures": {
            "1": "variable"
          },
          "consume": 1
        },
        {
          "match": "^([\\w./%$()*+@-]+(?:[ \\t]+[\\w./%$()*+@-]+)*)[ \\t]*::?(?:[ \\t]|$)",
          "captures": {
            "1": "function"
          }
        },
        {
          "match": "\\$\\((?:[A-Za-z_][\\w.]*)\\)|\\$\\{[A-Za-z_][\\w.]*\\}|\\$[@<^?*%+|]|\\$\\$",
          "class": "variable"
        },
        {
          "match": "\\$\\((?:subst|patsubst|strip|findstring|filter|filter-out|sort|word|words|wordlist|firstword|lastword|wildcard|shell|foreach|call|eval|if|or|and|origin|dir|notdir|basename|suffix|addprefix|addsuffix|join|abspath|realpath|error|warning|info)\\b",
          "class": "builtin"
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?|\\'[^\\'\\n]*\\'?",
          "class": "string"
        }
      ],
      "outline": [
        {
          "pattern": "^([A-Za-z0-9_/-][A-Za-z0-9_./-]*)[ \\t]*:(?:[ \\t]|$)",
          "kind": "function",
          "name": 1
        }
      ]
    },
    {
      "id": "config",
      "name": "Config",
      "extensions": [
        "yml",
        "yaml",
        "toml",
        "ini",
        "cfg",
        "conf",
        "cmake",
        "gitignore",
        "dockerfile",
        "env",
        "properties"
      ],
      "filenames": [
        "Dockerfile",
        ".gitignore",
        ".gitattributes",
        ".editorconfig",
        "CMakeLists.txt"
      ],
      "line_comment": "#",
      "brackets": [
        "()",
        "[]",
        "{}"
      ],
      "indent": {
        "mode": "keep",
        "size": 2
      },
      "fold": "indent",
      "grammar": [
        {
          "match": "(?:^|[ \\t])(#.*)$",
          "captures": {
            "1": "comment"
          }
        },
        {
          "match": "^[ \\t]*;.*$",
          "class": "comment"
        },
        {
          "match": "\"(?:[^\"\\\\\\n]|\\\\.)*\"?",
          "class": "string"
        },
        {
          "match": "'[^'\\n]*'?",
          "class": "string"
        },
        {
          "match": "^[ \\t]*\\[[^\\]\\n]+\\][ \\t]*$",
          "class": "heading"
        },
        {
          "match": "^[ \\t]*-?[ \\t]*([A-Za-z_][\\w.-]*)[ \\t]*[:=]",
          "captures": {
            "1": "variable"
          },
          "consume": 1
        },
        {
          "words": [
            "true",
            "false",
            "null",
            "yes",
            "no",
            "on",
            "off",
            "None"
          ],
          "class": "constant",
          "ignore_case": true
        },
        {
          "match": "\\b-?\\d+(?:\\.\\d+)?\\b",
          "class": "number"
        }
      ],
      "outline": [
        {
          "pattern": "^[ \\t]*\\[([^\\]\\n]+)\\][ \\t]*$",
          "kind": "module",
          "name": 1
        }
      ]
    }
  ],
  "run": [
    {
      "language": "shell",
      "name": "Run script",
      "command": "sh \"{file}\""
    }
  ],
  "check": [
    {
      "language": "shell",
      "name": "Syntax",
      "command": "sh -n \"{file}\"",
      "pattern": "^[^:\\n]+: (?:line )?(?P<line>\\d+): (?P<msg>[Ss]yntax error.*)$"
    }
  ],
  "tools": [],
  "detect": {
    "extensions": [
      "sh",
      "mk"
    ],
    "files": [
      "Makefile",
      "makefile",
      "GNUmakefile",
      "Dockerfile"
    ]
  },
  "templates": [
    {
      "name": "Script",
      "description": "run.sh",
      "open": "run.sh",
      "files": {
        "run.sh": "#!/bin/sh\nset -e\n\necho \"Hello, Light\"\n"
      }
    }
  ]
}
