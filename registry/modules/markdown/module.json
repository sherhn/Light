{
  "version": "1.1.1",
  "cover": "cover.png",
  "license": "MIT",
  "author": "Light contributors",
  "id": "markdown",
  "name": "Markdown",
  "category": "Documents",
  "summary": "Headings, emphasis, code, links and lists; Enter continues a list; folding and an outline by headings.",
  "description": "Markdown for Light: headings (# and underlined), bold, italic, inline code and fenced code blocks, links and images, block quotes, lists and tables are coloured; Enter at the end of a list item or a quotation continues it and Enter on an empty item ends it; the outline and folding follow the headings; Comment Line wraps a line in an HTML comment. A rendered preview shows the document next to the code or instead of it (Editor, Editor and Preview, Preview).",
  "languages": [
    {
      "id": "markdown",
      "name": "Markdown",
      "extensions": [
        "md",
        "markdown",
        "mdown",
        "mkd",
        "mdx"
      ],
      "filenames": [
        "README",
        "CHANGELOG",
        "LICENSE"
      ],
      "block_comment": [
        "<!--",
        "-->"
      ],
      "brackets": [],
      "indent": {
        "mode": "markup",
        "size": 2
      },
      "fold": "headings",
      "preview": "markdown",
      "grammar": [
        {
          "begin": "^[ \\t]*(?:```|~~~)",
          "end": "^[ \\t]*(?:```|~~~)[ \\t]*$",
          "class": "code"
        },
        {
          "begin": "<!--",
          "end": "-->",
          "class": "comment"
        },
        {
          "match": "^#{1,6}[ \\t].*$",
          "class": "heading"
        },
        {
          "match": "^[^\\s#>\\-*+`~|\\d<\\[!][^\\n]*\\n(?:=+|-+)[ \\t]*$",
          "class": "heading"
        },
        {
          "match": "^[ \\t]*(?:(?:\\*[ \\t]*){3,}|(?:-[ \\t]*){3,}|(?:_[ \\t]*){3,})$",
          "class": "prefix"
        },
        {
          "match": "^[ \\t]*\\|?[ \\t]*:?-{3,}:?[ \\t]*(?:\\|[ \\t]*:?-{3,}:?[ \\t]*)*\\|?[ \\t]*$",
          "class": "prefix"
        },
        {
          "match": "^[ \\t]*>.*$",
          "class": "quote"
        },
        {
          "match": "^[ \\t]*(?:[-*+]|\\d+[.)])[ \\t]+(?:\\[[ xX]\\][ \\t])?",
          "class": "prefix"
        },
        {
          "match": "``[^\\n]+?``|`[^`\\n]+`",
          "class": "code"
        },
        {
          "match": "!?\\[[^\\]\\n]*\\]\\([^)\\n]*\\)",
          "class": "link"
        },
        {
          "match": "!?\\[[^\\]\\n]+\\]\\[[^\\]\\n]*\\]",
          "class": "link"
        },
        {
          "match": "^[ \\t]*\\[[^\\]\\n]+\\]:[ \\t]*\\S+",
          "class": "link"
        },
        {
          "match": "<https?://[^>\\s]+>|https?://[^\\s)>\\]]+",
          "class": "link"
        },
        {
          "match": "\\*\\*[^*\\n]+\\*\\*|__[^_\\n]+__",
          "class": "strong"
        },
        {
          "match": "\\*[^*\\s][^*\\n]*\\*|\\b_[^_\\s][^_\\n]*_\\b",
          "class": "emphasis"
        },
        {
          "match": "~~[^~\\n]+~~",
          "class": "comment"
        },
        {
          "match": "</?[A-Za-z][\\w:-]*(?:[ \\t][^>\\n]*)?/?>",
          "class": "preproc"
        }
      ],
      "outline": [
        {
          "pattern": "^(#{1,6})[ \\t]+(.+?)[ \\t]*#*[ \\t]*$",
          "kind": "heading",
          "name": 2,
          "level": 1,
          "level_mode": "length"
        },
        {
          "pattern": "^([^\\s#>\\-*+`~|\\d<\\[!][^\\n]*)\\n(=+|-+)[ \\t]*$",
          "kind": "heading",
          "name": 1,
          "level": 2,
          "level_mode": "setext"
        }
      ]
    }
  ],
  "run": [],
  "tools": [],
  "detect": {
    "extensions": [
      "md",
      "markdown"
    ],
    "files": []
  },
  "templates": [
    {
      "name": "README",
      "description": "README.md",
      "open": "README.md",
      "files": {
        "README.md": "# Project\n\nWhat it is, in a sentence.\n\n## Getting started\n\n1. Clone it\n2. Build it\n3. Run it\n\n## Notes\n\n- one\n- two\n"
      }
    }
  ]
}
